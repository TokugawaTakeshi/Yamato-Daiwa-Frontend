      themeKeyLabelPrefix=@AdmonitionBlockDemoPage.THEME_KEY_LABEL_PREFIX
      geometricVariations=@typeof(AdmonitionBlock.StandardGeometricVariations)
      geometricVariationLabelPrefix=@AdmonitionBlockDemoPage.GEOMETRIC_VARIATION_KEY_LABEL_PREFIX
