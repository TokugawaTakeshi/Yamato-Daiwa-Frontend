@page "/Button"

@using YamatoDaiwa.Frontend.GUI_Components.Controls.Buttons.Plain
@using Demos.GUI_Components.ThemesShowcase;


<div class="YDF_Gallery">
  
  <h1 class="Heading1">Button Component Demos</h1>
  
  @* ━━━ Minimal ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ *@
  <h2 class="Heading2">Minimal</h2>
   
  <ThemesShowcase
    themes=@typeof(Button.StandardThemes)
    themeKeyLabelPrefix=@ButtonDemoPage.THEME_KEY_LABEL_PREFIX
    geometricVariations=@typeof(Button.StandardGeometricVariations)
    geometricVariationLabelPrefix=@ButtonDemoPage.GEOMETRIC_VARIATION_KEY_LABEL_PREFIX
    decorativeVariations=@typeof(Button.StandardDecorativeVariations)
    decorativeVariationLabelPrefix=@ButtonDemoPage.DECORATIVE_VARIATION_KEY_LABEL_PREFIX
    decorativeVariationsWrapperAdditionalCSS_Classes=@([ "BadgeGallery-TwoColumnsTable" ])
  >
    <ComponentSlot>
      <dl class="ButtonGallery-PseudoTable">
        
        <dt>Button</dt>
        <dd>
          <Button
            label="Click 押下"
            theme=@context.themeValue
            geometricVariation=@context.geometricVariationValue
            decorativeVariation=@context.decorativeVariationValue
          />
        </dd>
        
        <dt>Link</dt>
        <dd>
          <Button
            label="Click 押下"
            externalURI="https://frontend.yamato-daiwa.com/"
            mustOpenLinkInNewTab=@true
            mustRequestNotFollowLinkForCrawlingToSearchEngine=@true
            theme=@context.themeValue
            geometricVariation=@context.geometricVariationValue
            decorativeVariation=@context.decorativeVariationValue
          />
        </dd>
        
        <dt>Input</dt>
        <dd>
          <Button
            label="Click 押下"
            HTML_Type=@Button.HTML_Types.inputButton
            theme=@context.themeValue
            geometricVariation=@context.geometricVariationValue
            decorativeVariation=@context.decorativeVariationValue
          />
        </dd>
        
      </dl>
    </ComponentSlot>
  </ThemesShowcase>
  
</div>
