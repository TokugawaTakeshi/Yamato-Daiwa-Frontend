<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <PackageId>YamatoDaiwa.Frontend.Localizations.Russian</PackageId>
    <Title>Yamato Daiwa Frontend - Russian Localization</Title>
    <Description>Russian localization for "YamatoDaiwa.Frontend" package</Description>
    <Version>0.5.0</Version>
    <RootNamespace>YamatoDaiwa.Frontend.Localizations.Russian</RootNamespace>
    <TargetFrameworks>net9.0; net10.0</TargetFrameworks>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageProjectUrl>https://frontend.yamato-daiwa.com/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TokugawaTakeshi/Yamato-Daiwa-Frontend.git</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Package\YamatoDaiwa.Frontend.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="LICENSE.md" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>
