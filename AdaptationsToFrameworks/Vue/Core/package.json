{
  "name": "@yamato-daiwa/frontend-vue",
  "version": "2.0.0-experimental.6",
  "description": "The adaptation of \"@yamato-daiwa/frontend\" package for Vue framework and also some additional functionality.",
  "keywords": [
    "frontend",
    "vue"
  ],
  "author": {
    "name": "Yamato Daiwa Co., Ltd.",
    "email": "frontend-es-info@yamato-daiwa.com"
  },
  "license": "MIT",
  "homepage": "https://frontend.yamato-daiwa.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TokugawaTakeshi/yamato_daiwa-frontend.git"
  },
  "bugs": {
    "url": "https://github.com/TokugawaTakeshi/yamato_daiwa-frontend/issues",
    "email": "frontend-es-info@yamato-daiwa.com"
  },
  "module": "./Distributable/index.js",
  "types": "./Distributable/index.d.ts",
  "files": [
    "Distributable"
  ],
  "peerDependencies": {
    "@yamato-daiwa/es-extensions": "~1.9.0",
    "@yamato-daiwa/es-extensions-browserjs": "~1.9.0",
    "@yamato-daiwa/frontend": ">=2.0.0-beta.11",
    "vue": "~3.5.0",
    "vue-facing-decorator": "~3.0.0",
    "vue-router": "~5.3.0"
  },
  "dependencies": {
    "autosize": "6.0.1",
    "vue3-slide-up-down": "2.1.0"
  },
  "devDependencies": {
    "@types/autosize": "4.0.3",
    "@yamato-daiwa/automation": "0.10.0-alpha.3",
    "@yamato-daiwa/es-extensions": "1.9.3",
    "@yamato-daiwa/es-extensions-browserjs": "1.9.3",
    "@yamato-daiwa/frontend": "../../../Main/Core",
    "@yamato-daiwa/style_guides": "0.14.5",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "vue": "3.5.43",
    "vue-facing-decorator": "3.0.4",
    "vue-router": "5.3.1"
  },
  "scripts": {
    "Rebuild Distributable": "rimraf --glob Distributable/* && yda build --selectiveExecution Distributable --mode PRODUCTION & npm run \"Generate TypeScript Types\"",
    "Generate TypeScript Types": "tsc --project tsconfig.declarations.json --declaration --emitDeclarationOnly --outDir Distributable",
    "Start Workbenches": "rimraf --glob Workbenches/Output/* && yda build --selectiveExecution Workbenches --mode LOCAL_DEVELOPMENT",
    "Lint": "eslint",
    "Audit Production Dependencies Only": "npm audit --omit=dev",
    "Print Project Structure": "wsl tree -I \".git|.idea|node_modules|Distributable\" || tree -I \".git|.idea|node_modules|Distributable\""
  },
  "allowScripts": {
    "core-js@2.6.12": true,
    "es5-ext@0.10.64": true,
    "gifsicle@5.3.0": true,
    "husky@4.3.8": true,
    "mozjpeg@6.0.1": true,
    "optipng-bin@6.0.0": true,
    "pngquant-bin@6.0.1": true,
    "puppeteer@24.43.0": true,
    "vnu-jar@26.3.10": true
  }
}
