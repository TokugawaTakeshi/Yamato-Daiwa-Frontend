{

  "compilerOptions": {

    "target": "ES2020",
    "moduleResolution": "bundler",

    "noUnusedLocals": true,
    "noUnusedParameters": false, /* Actual for Vue3; see https://github.com/vuejs/vue-next/issues/4668 */
    "experimentalDecorators": true,

    "allowJs": true, /* Actual for Vue3; */
    "skipLibCheck": true

  },

  /* [ Theory ]
   * Webpack which under the hood of @yamato-daiwa/automation don't case about "include", "exclude" and "files"; this
   *   directive needs only for ESLint and IDEs */
  "include": [
    "Project.d.ts",
    "Source/**/*",
    "Workbenches/**/*",
    "Automation/**/*"
  ]

}
