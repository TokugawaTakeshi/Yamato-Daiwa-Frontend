{

  "compilerOptions": {

    "target": "ES2020",
    "moduleResolution": "bundler",

    "types": [ "node" ],

    "noUnusedLocals": true,
    "noUnusedParameters": false, /* Actual for Vue3; see https://github.com/vuejs/vue-next/issues/4668 */

    "experimentalDecorators": true,
    "allowJs": true, /* Actual for Vue3; */
    "skipLibCheck": true

  },

  "include": [
    "Project.d.ts",
    "Source/**/*"
  ]

}
