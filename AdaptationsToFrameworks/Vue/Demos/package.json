{
  "private": "true",
  "name": "@yamato-daiwa/frontend-vue-demos",
  "version": "0.0.0",
  "dependencies": {
    "@yamato-daiwa/es-extensions": "1.8.7",
    "@yamato-daiwa/es-extensions-browserjs": "1.8.7",
    "@yamato-daiwa/frontend": "../../../CoreLibrary/Package",
    "@yamato-daiwa/frontend-demos": "../../../CoreLibrary/Demos",
    "@yamato-daiwa/frontend-vue": "../Package",
    "vue": "3.5.34",
    "vue-facing-decorator": "3.0.4",
    "vue-router": "4.6.4",
    "vue3-slide-up-down": "2.1.0"
  },
  "devDependencies": {
    "@npmcli/package-json": "7.0.5",
    "@types/node": "22.19.19",
    "@types/npmcli__package-json": "4.0.4",
    "@yamato-daiwa/automation": "../../../../../../IntelliJ IDEA/InHouseDevelopment/YamatoDaiwaAutomation/MainPackage",
    "@yamato-daiwa/es-extensions-nodejs": "1.8.7",
    "@yamato-daiwa/style_guides": "0.14.2",
    "chokidar": "5.0.0",
    "rimraf": "6.1.3",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  },
  "scripts": {
    "Watch Local Galleries": "rimraf LocalGalleriesBuild && yda build --selectiveExecution LocalGalleries --mode LOCAL_DEVELOPMENT",
    "Provide Debugging of Vue Adaptation Package": "tsx YDF_VueAdaptationPackageDebuggingProvider --incremental",
    "Build Distributions": "rimraf Distributions && yda build --selectiveExecution Distributions --mode PRODUCTION && cd Distributions && git add .",
    "Get Source Markup of Partial Demos": "yda build --selectiveExecution PartialDemosSourceFiles --mode PRODUCTION",
    "Lint": "eslint .",
    "postinstall": "tsx YDF_VueAdaptationPackageDebuggingProvider"
  }
}
