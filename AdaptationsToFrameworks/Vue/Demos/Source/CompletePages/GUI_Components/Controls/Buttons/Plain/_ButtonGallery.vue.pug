  v-if="mustRenderAllPartials || partialsFlags.noRightBorderAndRoundingsGeometricModifier"
)

  h3.Heading3(
    :class="mustVisuallyHideAllHeadings ? 'YDF_Gallery-InvisibleHeading' : null"
  ) No Right Border and Roundings

  ThemesShowcase(
    :themes="Button.Themes"
    :themeKeyLabelPrefix="THEME_KEY_LABEL_PREFIX"
    :geometricVariations="Button.GeometricVariations"
    :geometricVariationLabelPrefix="GEOMETRIC_VARIATION_KEY_LABEL_PREFIX"
    :decorativeVariations="Button.DecorativeVariations"
    :decorativeVariationLabelPrefix="DECORATIVE_VARIATION_KEY_LABEL_PREFIX"
    :decorativeVariationsListItemAdditionalCSS_Classes="[ 'ButtonGallery-DecorativeVariationsListItem' ]"
    :decorativeVariationSkippingCondition="mustSkipDecorativeVariation"
  )
    template(
      v-slot="{ theme, geometricVariation, decorativeVariation }"
    )

      dl.ButtonGallery-PseudoTable

        dt Button
        dd
          Button(
            label="Click 押下"
            :theme="theme.value"
            :geometricVariation="geometricVariation.value"
            :geometricModifiers="[ Button.GeometricModifiers.noRightBorderAndRoundings ]"
            :decorativeVariation="decorativeVariation.value"
          )

        dt Link
        dd
          Button(
            label="Click 押下"
            externalURI="#"
            :theme="theme.value"
            :geometricVariation="geometricVariation.value"
            :geometricModifiers="[ Button.GeometricModifiers.noRightBorderAndRoundings ]"
            :decorativeVariation="decorativeVariation.value"
          )

        dt Input
        dd
          Button(
            label="Click 押下"
            :HTML_Type="Button.HTML_Types.inputButton"
            :theme="theme.value"
            :geometricVariation="geometricVariation.value"
            :geometricModifiers="[ Button.GeometricModifiers.noRightBorderAndRoundings ]"
            :decorativeVariation="decorativeVariation.value"
          )


