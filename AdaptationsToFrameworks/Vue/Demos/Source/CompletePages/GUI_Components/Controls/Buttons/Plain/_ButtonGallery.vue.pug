//- ━━━ Loading Placeholder ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
template(
  v-if="mustRenderAllPartials || partialsFlags.loadingPlaceholder"
)

  h2.Heading2(
    :class="mustVisuallyHideAllHeadings ? 'YDF_Gallery-InvisibleHeading' : null"
  ) Loading Placeholder

  .ButtonGallery-LinearFlow

    template(
      v-for="geometricVariation of Object.values(Button.GeometricVariations)"
    )

      ButtonLoadingPlaceholder(
        :key="`BUTTON-LOADING_PLACEHOLDER-${ geometricVariation }`"
        :geometricVariation="geometricVariation"
      )

      ButtonLoadingPlaceholder(
        :key="`BUTTON-LOADING_PLACEHOLDER-${ geometricVariation }-PILL_SHAPE`"
        :geometricVariation="geometricVariation"
        :geometricModifiers="[ Button.GeometricModifiers.pillShape ]"
      )
