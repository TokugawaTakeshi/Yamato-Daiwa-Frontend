    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@yamato-daiwa/frontend": "2.0.0-beta.11",
    "@yamato-daiwa/style_guides": "0.11.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router": "7.11.0",
    "rimraf": "6.1.2",
    "typescript": "5.9.3"
  },
  "scripts": {
    "Rebuild Distributable": "yda build --selectiveExecution Distributable --mode PRODUCTION & npm run \"Generate TypeScript Types\"",
