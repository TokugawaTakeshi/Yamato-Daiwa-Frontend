{
  "name": "@yamato-daiwa/frontend-react",
  "version": "0.3.0",
  "description": "The adaptation of \"@yamato-daiwa/frontend\" package for React framework and also some additional functionality.",
  "keywords": [
    "frontend",
    "react"
  ],
  "author": {
    "name": "Yamato Daiwa Co., Ltd.",
    "email": "frontend-es-info@yamato-daiwa.com"
  },
  "license": "MIT",
  "homepage": "https://frontend.yamato-daiwa.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TokugawaTakeshi/yamato_daiwa-frontend.git"
  },
  "bugs": {
    "url": "https://github.com/TokugawaTakeshi/yamato_daiwa-frontend/issues",
    "email": "frontend-es-info@yamato-daiwa.com"
  },
  "module": "./Distributable/index.js",
  "types": "./Distributable/index.d.ts",
  "files": [
    "Distributable"
  ],
  "peerDependencies": {
    "@yamato-daiwa/frontend": "2.0.0-beta.11",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "react-router": "~8.4.0"
  },
  "dependencies": {
    "@yamato-daiwa/es-extensions": "1.9.3",
    "@yamato-daiwa/es-extensions-browserjs": "1.9.3"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@yamato-daiwa/automation": "0.10.0-alpha.3",
    "@yamato-daiwa/frontend": "2.0.0-beta.11",
    "@yamato-daiwa/style_guides": "0.14.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "rimraf": "6.1.3",
    "typescript": "6.0.3"
  },
  "scripts": {
    "Rebuild Distributable": "yda build --selectiveExecution Distributable --mode PRODUCTION & npm run \"Generate TypeScript Types\"",
    "Generate TypeScript Types": "tsc --project tsconfig.json --declaration --emitDeclarationOnly --outDir Distributable",
    "Start Workbenches": "rimraf Workbenches/Output && yda build --selectiveExecution Workbenches --mode LOCAL_DEVELOPMENT",
    "Lint": "eslint",
    "Audit Production Dependencies Only": "npm audit --omit=dev",
    "Print Project Structure": "wsl tree -I \".git|.idea|node_modules|Distributable\" || tree -I \".git|.idea|node_modules|Distributable\""
  },
  "allowScripts": {
    "core-js@2.6.12": true,
    "es5-ext@0.10.64": true,
    "esbuild@0.28.2": true,
    "gifsicle@5.3.0": true,
    "husky@4.3.8": true,
    "mozjpeg@6.0.1": true,
    "nodemon@2.0.18": true,
    "optipng-bin@6.0.0": true,
    "pngquant-bin@6.0.1": true,
    "puppeteer@25.12.0": true,
    "vnu-jar@26.3.10": true
  }
}
