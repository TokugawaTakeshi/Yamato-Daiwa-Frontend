{
  "private": true,
  "name": "@yamato-daiwa/frontend-react-demos",
  "version": "0.0.0",
  "dependencies": {
    "@yamato-daiwa/es-extensions": "1.9.3",
    "@yamato-daiwa/es-extensions-browserjs": "1.9.3",
    "@yamato-daiwa/frontend": "../../../Main/Core",
    "@yamato-daiwa/frontend-demos": "../../../Main/Core",
    "@yamato-daiwa/frontend-react": "../Package",
    "prop-types": "15.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-router-dom": "5.3.3",
    "@yamato-daiwa/automation": "0.10.0-alpha.3",
    "@yamato-daiwa/style_guides": "0.14.5",
    "rimraf": "6.1.3",
    "typescript": "6.0.3"
  },
  "scripts": {
    "Watch Local Galleries": "rimraf LocalGalleriesBuild && yda build --selectiveExecution LocalGalleries --mode LOCAL_DEVELOPMENT",
    "Build Distributions": "rimraf Distributions && yda build --selectiveExecution Distributions --mode PRODUCTION && cd Distributions && git add .",
    "Get Source Markup of Partial Demos": "yda build --selectiveExecution PartialDemosSourceFiles --mode PRODUCTION",
    "Audit Production Dependencies Only": "npm audit --omit=dev",
    "Lint": "eslint",
    "Print Project Structure": "wsl tree -I \".git|.idea|node_modules|Distributions|LocalGalleriesBuild\" || tree -I \".git|.idea|node_modules|Distributions|LocalGalleriesBuild\""
  },
  "allowScripts": {
    "core-js@2.6.12": true,
    "es5-ext@0.10.64": true,
    "esbuild@0.28.2": true,
    "gifsicle@5.3.0": true,
    "husky@4.3.8": true,
    "mozjpeg@6.0.1": true,
    "nodemon@2.0.18": true,
    "optipng-bin@6.0.0": true,
    "pngquant-bin@6.0.1": true,
    "puppeteer@25.12.0": true,
    "vnu-jar@26.3.10": true
  }
}
