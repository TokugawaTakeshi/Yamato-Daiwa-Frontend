mixin TextBoxGallery

  -

    ThemesShowcase__YDF.
        setDefaultThemeKeyLabelPrefix("TextBoxGallery__YDF.Themes.").
        setDefaultGeometricVariationLabelPrefix("TextBoxGallery__YDF.GeometricVariations.").
        setDefaultDecorativeVariationLabelPrefix("TextBoxGallery__YDF.DecorativeVariations.");

    const themeShowcaseCurrentIterationData = ThemesShowcase__YDF.initializeCurrentIterationData();

    function skipDecorativeVariationIf(iterationData) {
      return (
        iterationData.decorativeVariation.value === TextBox__YDF.DecorativeVariations.labelLike &&
        iterationData.geometricVariation.value !== TextBox__YDF.GeometricVariations.labelLike
      ) ||
      (
        iterationData.decorativeVariation.value !== TextBox__YDF.DecorativeVariations.labelLike &&
        iterationData.geometricVariation.value === TextBox__YDF.GeometricVariations.labelLike
      );
    }

    const propertiesForTextBoxesOfEachType = {
      [TextBox__YDF.HTML_Types.regular]: {
        label: "Sample",
        guidance: "Please input the name",
        accessibilityGuidance: "Sample",
        value: "sample サンプル",
        autocomplete: "name"
      },
      [TextBox__YDF.HTML_Types.email]: {
        label: "Email",
        guidance: "Please input the email address.",
        accessibilityGuidance: "Email",
        value: "example@example.com",
        autocomplete: "email"
      },
      [TextBox__YDF.HTML_Types.number]: {
        label: "Age",
        guidance: "Please input you age.",
        accessibilityGuidance: "Age",
        value: 30,
        /* Wrong autocomplete, but there is not "age" one. */
        autocomplete: "bday-year"
      },
      [TextBox__YDF.HTML_Types.password]: {
        label: "Password",
        guidance: "Please input the password.",
        accessibilityGuidance: "Password",
        value: "r1H5qf.hr:}]'\\4{qF+gu%im",
        autocomplete: "current-password"
      },
      [TextBox__YDF.HTML_Types.phoneNumber]: {
        label: "Phone Number",
        guidance: "Please input your phone number.",
        accessibilityGuidance: "Phone Number",
        value: "132-4567-8901",
        autocomplete: "tel"
      },
      [TextBox__YDF.HTML_Types.URI]: {
        label: "Website",
        guidance: "Please input the valid URL.",
        accessibilityGuidance: "Website",
        value: "https://frontend.yamato-daiwa.com/",
        autocomplete: "url"
      }
    };


  h1.Heading1(
    class=(GalleryConfigurator.mustVisuallyHideTopHeading ? "YDF_Gallery-InvisibleHeading" : [])
  ) TextBox Component Demos

  //- ━━━ Minimal ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  if GalleryConfigurator.partialsRenderingFlags[GalleryConfigurator.Partials.minimal]

    h2.Heading2(
      class=(GalleryConfigurator.mustVisuallyHideAllHeadings ? "YDF_Gallery-InvisibleHeading" : [])
    ) Minimal

    +ThemesShowcase--YDF({
      themes: TextBox__YDF.Themes,
      geometricVariations: TextBox__YDF.GeometricVariations,
      decorativeVariations: TextBox__YDF.DecorativeVariations,
      skipDecorativeVariationIf,
      iterationData: themeShowcaseCurrentIterationData,
      decorativeVariationsListItemAdditionalCSS_Classes: "TextBoxGallery-VerticalLinearFlow"
    })

      each properties, HTML_Type in propertiesForTextBoxesOfEachType

        +TextBox--YDF({
          HTML_Type,
          accessibilityGuidance: properties.accessibilityGuidance,
          value: properties.value,
          theme: themeShowcaseCurrentIterationData.theme.value,
          geometricVariation: themeShowcaseCurrentIterationData.geometricVariation.value,
          decorativeVariation: themeShowcaseCurrentIterationData.decorativeVariation.value
        })


  //- ━━━ Surrounding ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
