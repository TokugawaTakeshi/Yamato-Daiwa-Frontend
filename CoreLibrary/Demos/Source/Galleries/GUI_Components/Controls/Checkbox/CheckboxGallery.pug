include CheckboxGalleryOptions.pug


mixin CheckboxGallery

  -

    ThemesShowcase__YDF.
        setDefaultThemeKeyLabelPrefix("Checkbox__YDF.Themes.").
        setDefaultGeometricVariationLabelPrefix("Checkbox__YDF.GeometricVariations.").
        setDefaultDecorativeVariationLabelPrefix("Checkbox__YDF.DecorativeVariations.");

    const themeShowcaseCurrentIterationData = ThemesShowcase__YDF.initializeCurrentIterationData();

    function skipDecorativeVariationIf(iterationData) {
      return (
        iterationData.decorativeVariation.value === Checkbox__YDF.DecorativeVariations.minimalistic &&
        iterationData.geometricVariation.value !== Checkbox__YDF.GeometricVariations.minimalistic
      ) ||
      (
        iterationData.decorativeVariation.value !== Checkbox__YDF.DecorativeVariations.minimalistic &&
        iterationData.geometricVariation.value === Checkbox__YDF.GeometricVariations.minimalistic
      );
    }


  h1.Heading1(
    class=(CheckboxGalleryOptions.mustVisuallyHideTopHeading ? "YDF_Gallery-InvisibleHeading" : [])
  ) Checkbox Component Demos

  //- ━━━ Minimal ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  if CheckboxGalleryOptions.partialsRenderingFlags[CheckboxGalleryOptions.Partials.minimal]

    h2.Heading2(
      class=(CheckboxGalleryOptions.mustVisuallyHideAllHeadings ? "YDF_Gallery-InvisibleHeading" : [])
    ) Minimal

    +ThemesShowcase--YDF({
      themes: Checkbox__YDF.Themes,
      geometricVariations: Checkbox__YDF.GeometricVariations,
      decorativeVariations: Checkbox__YDF.DecorativeVariations,
      iterationData: themeShowcaseCurrentIterationData,
      decorativeVariationsListItemAdditionalCSS_Classes: [ "CheckboxGallery-PairFlow" ],
      skipDecorativeVariationIf
    })

      +Checkbox--YDF({
        label: "I am O'K",
        theme: themeShowcaseCurrentIterationData.theme.value,
        geometricVariation: themeShowcaseCurrentIterationData.geometricVariation.value,
        decorativeVariation: themeShowcaseCurrentIterationData.decorativeVariation.value,
        checked: false
      })

      +Checkbox--YDF({
        label: "I am O'K",
        theme: themeShowcaseCurrentIterationData.theme.value,
        geometricVariation: themeShowcaseCurrentIterationData.geometricVariation.value,
        decorativeVariation: themeShowcaseCurrentIterationData.decorativeVariation.value,
        checked: true
      })


    //- ━━━ Geometric Modifiers ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    if CheckboxGalleryOptions.mustRenderGeometricModifiersSection

    h2.Heading2(
      class=(CheckboxGalleryOptions.mustVisuallyHideAllHeadings ? "YDF_Gallery-InvisibleHeading" : [])
    ) Geometric Modifiers


    //- ─── Square Shape ───────────────────────────────────────────────────────────────────────────────────────────────
    if CheckboxGalleryOptions.partialsRenderingFlags[CheckboxGalleryOptions.Partials.squareShapeGeometricModifier]

      h3.Heading3(
        class=(CheckboxGalleryOptions.mustVisuallyHideAllHeadings ? "YDF_Gallery-InvisibleHeading" : [])
      ) Square Shape

      +ThemesShowcase--YDF({
        themes: Checkbox__YDF.Themes,
        geometricVariations: Checkbox__YDF.GeometricVariations,
        decorativeVariations: Checkbox__YDF.DecorativeVariations,
        iterationData: themeShowcaseCurrentIterationData,
        skipDecorativeVariationIf
      })
