        targetObject: variation,
        targetObjectName: VARIATION_FULLY_QUALIFIED_NAME_FOR_LOGGING,
        assigments: {
          font-size: {
            dotSeparatedPath: "badge.basicSize",
            required: true
          }
        }
      })


      &:first-child

        validateAndAssignStoredInObjectCSS_Properties({
          targetObject: variation,
          targetObjectName: VARIATION_FULLY_QUALIFIED_NAME_FOR_LOGGING,
          assigments: {
            margin-left: {
              dotSeparatedPath: "badge.spacing.leftWhenGoingFirst",
              required: false
