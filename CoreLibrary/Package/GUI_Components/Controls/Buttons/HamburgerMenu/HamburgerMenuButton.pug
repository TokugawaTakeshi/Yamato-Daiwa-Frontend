include HamburgerMenuButton.class.pug

//-
  [ References ]
  Accessibility: https://www.accede-web.com/en/guidelines/rich-interface-components/hamburger-menu/
  Animation: https://www.w3schools.com/howto/howto_css_menu_icon.asp

mixin HamburgerMenuButton--YDF(properties)


  -

    const {

      /** @type { string | undefined } */
      customLabel,

      /**
       * @type { boolean }
       * @default false
       * */
      noLabel,

      /**
       * @type { string }
       * @default HamburgerMenuButton__YDF.LabelLetterCases.lowercase
       * */
      labelLetterCase,

      /**
       * @type { boolean }
       * @default false
       * */
      alwaysEnglishLabel,

      /** @type { string | undefined } */
      accessibilityGuidance,

      /**
       * @type { string }
       * @default HamburgerMenuButton__YDF.Themes.regular
       * */
      theme,

      /**
       * @type { boolean }
       * @default HamburgerMenuButton__YDF.areThemesCSS_ClassesCommon
       */
      areThemesCSS_ClassesCommon,

      /**
       * @type { string }
       * @default HamburgerMenuButton__YDF.GeometricVariations.regular
       */
      geometricVariation,

      /**
       * @type { Array<HamburgerMenuButton__YDF.GeometricModifiers> }
       * @default []
       */
      geometricModifiers,

      /**
       * @type { string }
       * @default HamburgerMenuButton__YDF.DecorativeVariations.regular
       * */
      decorativeVariation,

      /**
       * @type { Array<HamburgerMenuButton__YDF.DecorativeModifiers> }
       * @default []
       */
      decorativeModifiers

    } = processObjectTypeParameterOfPugMixin({
      rawParameter: properties,
      parameterNumber: 1,
      parameterName: "properties",
      parameterPropertiesSpecification: HamburgerMenuButton__YDF.propertiesSpecification,
      mixinName: HamburgerMenuButton__YDF.CSS_NAMESPACE
    });


    /** @type { Array<string> } */
    const rootElementModifierCSS_Classes = [

      ...ComponentsAuxiliaries.addThemeCSS_ClassToArrayIfMust({
        theme,
        allThemes: HamburgerMenuButton__YDF.Themes,
        CSS_Namespace: HamburgerMenuButton__YDF.CSS_NAMESPACE,
        areThemesCSS_ClassesCommon
      }),

      ...ComponentsAuxiliaries.addGeometricVariationCSS_ClassToArrayIfMust({
        geometricVariation,
        allGeometricVariations: HamburgerMenuButton__YDF.GeometricVariations,
        CSS_Namespace: HamburgerMenuButton__YDF.CSS_NAMESPACE
      }),

      ...ComponentsAuxiliaries.generateDemandedGeometricModifiersCSS_Classes(
        HamburgerMenuButton__YDF.CSS_NAMESPACE, geometricModifiers
      ),

      ...ComponentsAuxiliaries.addDecorativeVariationCSS_ClassToArrayIfMust({
        decorativeVariation,
        allDecorativeVariations: HamburgerMenuButton__YDF.DecorativeVariations,
        CSS_Namespace: HamburgerMenuButton__YDF.CSS_NAMESPACE
      }),

      ...ComponentsAuxiliaries.generateDemandedDecorativeModifiersCSS_Classes(
        HamburgerMenuButton__YDF.CSS_NAMESPACE, decorativeModifiers
      )

    ];

    /** @type { string } */
    const labelCSS_ModifierClass =
        {
          [HamburgerMenuButton__YDF.LabelLetterCases.uppercase]:
              `${ HamburgerMenuButton__YDF.CSS_NAMESPACE }-Label__Uppercase`,
          [HamburgerMenuButton__YDF.LabelLetterCases.lowercase]:
              `${ HamburgerMenuButton__YDF.CSS_NAMESPACE }-Label__Lowercase`,
          [HamburgerMenuButton__YDF.LabelLetterCases.capitalisation]:
              `${ HamburgerMenuButton__YDF.CSS_NAMESPACE }-Label__Capitalisation`
        }[labelLetterCase];


  button.HamburgerMenuButton--YDF(
    type="button"
    class=rootElementModifierCSS_Classes
    aria-label= (noLabel ? (accessibilityGuidance || HamburgerMenuButton__YDF.localization.defaultAccessibilityGuidance) : null)
  )&attributes(attributes)

    span.HamburgerMenuButton--YDF-Icon(role="presentation")

    if !noLabel

      span.HamburgerMenuButton--YDF-Label(
        class= labelCSS_ModifierClass
      )
        if alwaysEnglishLabel
          | MENU
        else
          | #{ customLabel || HamburgerMenuButton__YDF.localization.defaultLabel }
