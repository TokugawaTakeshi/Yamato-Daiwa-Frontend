include Checkbox.class.pug


mixin Checkbox--YDF(properties)

  -

    const {

      /** @type { string | undefined } */
      label,

      /** @type { string | undefined } */
      externalLabelHTML_ID,

      /** @type { string | undefined } */
      HTML_Name,

      /** @type { string | undefined } */
      HTML_Value,

      /** @type { string | undefined } */
      instanceID_UniqueDynamicPart,

      /**
       * @type { string }
       * @description There is NO such property will be passed, but it is elegant to initialize it here.
       * */
      INSTANCE_ID = Checkbox__YDF.generateInstanceID(instanceID_UniqueDynamicPart),

      /** @type { string } */
      inputElementHTML_ID = `${ INSTANCE_ID }-INPUT`,

      /**
       * @type { boolean }
       * @default false
       * */
      checked,

      /**
       * @type { boolean }
       * @default false
       * */
      disabled,

      /**
       * @type { boolean }
       * @default false
       * */
      readonly,

      /**
       * @type { string }
       * @default Checkbox__YDF.Themes.regular
       * */
      theme,

      /**
       * @type { boolean }
       * @default Checkbox__YDF.areThemesCSS_ClassesCommon
       */
      areThemesCSS_ClassesCommon,

      /**
       * @type { string }
       * @default Checkbox__YDF.GeometricVariations.regular
       */
      geometricVariation,

      /**
       * @type { Array<Checkbox__YDF.GeometricModifiers> }
       * @default []
       */
      geometricModifiers,

      /**
       * @type { string }
       * @default Checkbox__YDF.DecorativeVariations.regular
       * */
      decorativeVariation

    } = processObjectTypeParameterOfPugMixin({
      rawParameter: properties,
      parameterNumber: 1,
      parameterName: "properties",
      parameterPropertiesSpecification: Checkbox__YDF.propertiesSpecification,
      mixinName: Checkbox__YDF.CSS_NAMESPACE
    });

    const {

      /**
       * @type { boolean }
       * @default false
       * */
      invalidInputHighlightingIfAnyValidationErrorsMessages,

      /**
       * @type { boolean }
       * @default false
       * */
      validValueHighlightingIfNoValidationErrorsMessages,

      /**
       * @type { boolean | ReadonlyArray<string> }
       * @default false
       * */
      validationErrorsMessages,

      /**
       * @type { boolean | ReadonlyArray<"IN_PROGRESS" | "FINISHED_BUT_INVALID" | "FINISHED_AND_VALID" | "MALFUNCTION"> }
       * @default false
       * */
      asynchronousValidationsStatuses

    } = processObjectTypeParameterOfPugMixin({
      rawParameter: statesSimulations,
      parameterNumber: 2,
      parameterName: "statesSimulations",
      parameterPropertiesSpecification: TextBox__YDF.statesSimulationsSpecification,
      mixinName: TextBox__YDF.CSS_NAMESPACE
    });

    /** @type { Array<string> } */
    const rootElementModifierCSS_Classes = [

      ...checked ?
        [ `${ Checkbox__YDF.CSS_NAMESPACE }__CheckedState` ] :
        [ `${ Checkbox__YDF.CSS_NAMESPACE }__UncheckedState` ],

      ...disabled ? [ `${ Checkbox__YDF.CSS_NAMESPACE }__DisabledState` ] : [],
      ...readonly ? [ `${ Checkbox__YDF.CSS_NAMESPACE }__ReadOnlyState` ] : [],

      ...ComponentsAuxiliaries.addThemeCSS_ClassToArrayIfMust({
        theme,
        allThemes: Checkbox__YDF.Themes,
        CSS_Namespace: Checkbox__YDF.CSS_NAMESPACE,
        areThemesCSS_ClassesCommon
      }),

      ...ComponentsAuxiliaries.addGeometricVariationCSS_ClassToArrayIfMust({
        geometricVariation,
        allGeometricVariations: Checkbox__YDF.GeometricVariations,
        CSS_Namespace: Checkbox__YDF.CSS_NAMESPACE
      }),

      ...ComponentsAuxiliaries.
          generateDemandedGeometricModifiersCSS_Classes(Checkbox__YDF.CSS_NAMESPACE, geometricModifiers),

      ...ComponentsAuxiliaries.addDecorativeVariationCSS_ClassToArrayIfMust({
        decorativeVariation,
        allDecorativeVariations: Checkbox__YDF.DecorativeVariations,
        CSS_Namespace: Checkbox__YDF.CSS_NAMESPACE
      })

    ];



  +ValidatableControlShell--YDF(
    {

      label,
      guidance,

      required,
      mustDisplayAppropriateBadgeIfInputIsRequired,
      mustDisplayAppropriateBadgeIfInputIsOptional,
      mustAddInvisibleBadgeForHeightEqualizingWhenNoBadge,
      coreElementHTML_ID: inputElementHTML_ID,
      labelElementHTML_ID: labelElementHTML_ID,

      mainSlotWrapperAdditionalCSS_Classes: [ "Checkbox--YDF-ButtonLikeWrapper" ],

      theme: Checkbox__YDF.selfAndChildrenComponentsThemesCorrespondence.validatableControlShell[theme],
      areThemesCSS_ClassesCommon,
      geometricVariation: Checkbox__YDF.selfAndChildrenComponentsGeometricVariationsCorrespondence.
          validatableControlShell[geometricVariation],
      decorativeVariation: Checkbox__YDF.selfAndChildrenComponentsDecorativeVariationsCorrespondence.
          validatableControlShell[decorativeVariation]

    },
    {
      validationErrorsMessages,
      asynchronousValidationsStatuses
    }
  ).Checkbox--YDF&attributes(attributes)(
    class=rootElementModifierCSS_Classes
  )

    span.Checkbox--YDF-FrameForCheckmark(
      role="presentation"
    )
      span.Checkbox--YDF-Checkmark

    if label

      label.Checkbox--YDF-Label(
        for=inputElementHTML_ID
      )= label

    input.Checkbox--YDF-HiddenInputElement(
      type="checkbox"
      name=HTML_Name
      value=HTML_Value
      checked=checked
      disabled=disabled
      readonly=readonly
      id=inputElementHTML_ID
      aria-labelledby=externalLabelHTML_ID
    )
