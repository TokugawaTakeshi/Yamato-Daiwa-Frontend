include DateTimePicker.class.pug


mixin DateTimePicker--YDF(properties, statesSimulations, initialValueFormatter)

  -

    const {

      label,
      accessibilityGuidance,
      externalLabelHTML_ID,
      guidance,

      mode,
      value,

      disabled,
      readonly,

      required,
      mustDisplayAppropriateBadgeIfInputIsRequired,
      mustDisplayAppropriateBadgeIfInputIsOptional,
      mustAddInvisibleBadgeForHeightEqualizingWhenNoBadge,

      instanceID_UniqueDynamicPart,
      HTML_IDs,

      theme,
      areThemesCSS_ClassesCommon,
      geometricVariation,
      geometricModifiers,
      decorativeVariation,
      decorativeModifiers

    } = YDF.processObjectTypeParameterOfPugMixin({
      rawParameter: properties,
      parameterNumber: 1,
      parameterName: "properties",
      parameterPropertiesSpecification: DateTimePicker__YDF.propertiesSpecification,
      mixinName: DateTimePicker__YDF.CSS_NAMESPACE
    });

    const {
      expanded,
      activeMatrix,
      invalidInputHighlightingIfAnyValidationErrorsMessages,
      validValueHighlightingIfNoValidationErrorsMessages,
      validationErrorsMessages,
      asynchronousValidationsStatuses
    } = YDF.processObjectTypeParameterOfPugMixin({
      rawParameter: statesSimulations,
      parameterNumber: 2,
      parameterName: "statesSimulations",
      parameterPropertiesSpecification: DateTimePicker__YDF.statesSimulationsSpecification,
      mixinName: DateTimePicker__YDF.CSS_NAMESPACE
    });


    /** @type { string } */
    const INSTANCE_ID = DateTimePicker__YDF.generateInstanceID(instanceID_UniqueDynamicPart);

    const {

      /** @type { string } */
      input: nativeInputElementHTML_ID = `${ INSTANCE_ID }-INPUT`,

      /** @type { string } */
      label: labelElementHTML_ID = `${ INSTANCE_ID }-LABEL`

    } = HTML_IDs ?? {};

    const rootElementModifierCSS_Classes = [

      ...disabled ? [ `${ DateTimePicker__YDF.CSS_NAMESPACE }__DisabledState` ] : [],
      ...invalidInputHighlightingIfAnyValidationErrorsMessages && validationErrorsMessages.length > 0 ?
          [ `${ DateTimePicker.CSS_NAMESPACE }__InvalidValueState` ] : [],
      ...validValueHighlightingIfNoValidationErrorsMessages && validationErrorsMessages.length === 0 ?
          [ `${ DateTimePicker.CSS_NAMESPACE }__ValueState` ] : [],

      ...ComponentsAuxiliaries.addThemeCSS_ClassToArrayIfMust({
        theme,
        allThemes: DateTimePicker__YDF.Themes,
        CSS_Namespace: DateTimePicker__YDF.CSS_NAMESPACE,
        areThemesCSS_ClassesCommon
      }),

      ...ComponentsAuxiliaries.addGeometricVariationCSS_ClassToArrayIfMust({
        geometricVariation,
        allGeometricVariations: DateTimePicker__YDF.GeometricVariations,
        CSS_Namespace: DateTimePicker__YDF.CSS_NAMESPACE
      }),

      ...ComponentsAuxiliaries.addDecorativeVariationCSS_ClassToArrayIfMust({
        decorativeVariation,
        allDecorativeVariations: DateTimePicker__YDF.DecorativeVariations,
        CSS_Namespace: DateTimePicker__YDF.CSS_NAMESPACE
      })

    ];

    const initiallyDisplayingYear = new Date().getFullYear();
    const initiallyDisplayingMonthNumber__numerationFrom0 = new Date().getMonth();

    const initial6x7DaysMatrix = YDF.CalendarBuilder.generateDataFor6x7DaysMatrix({
      targetYear: initiallyDisplayingYear,
      targetMonthNumber__numerationFrom0: initiallyDisplayingMonthNumber__numerationFrom0,
      firstDayOfWeek__numerationFrom0ForSunday: 0
    });

    const toggleAccessibilityGuidance = expanded ?
        DateTimePicker__YDF.localization.expandingToggle.collapsedState.accessibilityGuidance :
        DateTimePicker__YDF.localization.expandingToggle.expandedState.accessibilityGuidance;

    const isInitialValueRepresentsValidDateAndPossiblyTime =
        isNotUndefined(value) && new Date(value).toString() !== "Invalid Date";

    /** @type { string | undefined } */
    let valueAttributeForInputElement;

    /** @type { string | undefined } */
    let formattedLocalDateAndPossiblyTime;

    if (isInitialValueRepresentsValidDateAndPossiblyTime) {

      switch (mode) {

        case DateTimePicker__YDF.Modes.dateWithTime: {

          valueAttributeForInputElement = new Date(value).toISOString().slice(0, 16);
          formattedLocalDateAndPossiblyTime = new Date(value).toLocaleString();

          break;
        }

        case DateTimePicker__YDF.Modes.dateOnly: {

          valueAttributeForInputElement = new Date(value).toISOString().slice(0, 10);
          formattedLocalDateAndPossiblyTime = new Date(value).toLocaleDateString();

        }

      }

    }


  +ValidatableControlShell--YDF(
    {

      label,
      guidance,

      required,
      mustDisplayAppropriateBadgeIfInputIsRequired,
      mustDisplayAppropriateBadgeIfInputIsOptional,
      mustAddInvisibleBadgeForHeightEqualizingWhenNoBadge,
      coreElementHTML_ID: nativeInputElementHTML_ID,
      labelElementHTML_ID: labelElementHTML_ID,

      mainSlotWrapperAdditionalCSS_Classes: [ "DateTimePicker--YDF-DialogRelativePositioner" ],

      theme: DateTimePicker__YDF.selfAndChildrenComponentsThemesCorrespondence.validatableControlShell[theme],
      areThemesCSS_ClassesCommon,
      geometricVariation: DateTimePicker__YDF.selfAndChildrenComponentsThemesCorrespondence.
          validatableControlShell[geometricVariation],
      decorativeVariation: DateTimePicker__YDF.selfAndChildrenComponentsThemesCorrespondence.
          validatableControlShell[decorativeVariation]

    },
    {
      validationErrorsMessages,
      asynchronousValidationsStatuses
    }
  ).DateTimePicker--YDF&attributes(attributes)(
    class=rootElementModifierCSS_Classes
    data-mode=mode
    data-initial_value=(valueAttributeForInputElement ? null : value)
  )

    input.DateTimePicker--YDF-NativeInputElement(
      type=(mode === DateTimePicker__YDF.Modes.dateWithTime ? "datetime-local" : "date")
      value=valueAttributeForInputElement
      id=nativeInputElementHTML_ID
      aria-label=accessibilityGuidance
      aria-labelledby=externalLabelHTML_ID
    )

    button.DateTimePicker--YDF-IndicatorButton(
      type="button"
      aria-label=toggleAccessibilityGuidance
    )

      case mode

        when DateTimePicker__YDF.Modes.dateWithTime

          +Calendar__Time--YDF_Icon.DateTimePicker--YDF-IndicatorButton-Icon

        default

          +Calendar__Date--YDF_Icon.DateTimePicker--YDF-IndicatorButton-Icon

      span.DateTimePicker--YDF-IndicatorButton-Label

        if isInitialValueRepresentsValidDateAndPossiblyTime

          if isNotUndefined(initialValueFormatter)
            | #{ initialValueFormatter(value) }
          else
            | #{ formattedLocalDateAndPossiblyTime }

    if expanded

      .DateTimePicker--YDF-Dialog(
        role="dialog"
        aria-modal="true"
      )

        .DateTimePicker--YDF-Dialog-TopActionBar

          case activeMatrix

            when DateTimePicker__YDF.Matrices.days

              table.DateTimePicker--YDF-Dialog-TopActionBar-TwoPairsButtonsTable&attributes({
                [DateTimePicker__YDF.DOM_AccessResources.dialog.topActionBar.daysActions.DATA_ATTRIBUTE_KEY]: ""
              })

                thead: tr

                  th(colspan="2")&attributes({
                    [DateTimePicker__YDF.DOM_AccessResources.dialog.topActionBar.daysActions.columnsTitles.closestMonths.DATA_ATTRIBUTE_KEY]: ""
                  })= DateTimePicker__YDF.localization.dialog.topActionBar.dateSelectingMode.labels.month

                  th(colspan="2")&attributes({
                    [DateTimePicker__YDF.DOM_AccessResources.dialog.topActionBar.daysActions.columnsTitles.selectingPanels.DATA_ATTRIBUTE_KEY]: ""
                  })= DateTimePicker__YDF.localization.dialog.topActionBar.dateSelectingMode.labels.selectingPanels

                tbody: tr

                  td
                    +Button--YDF({
                      geometricVariation: Button__YDF.GeometricVariations.small
                    })&attributes({
                      [DateTimePicker__YDF.DOM_AccessResources.dialog.topActionBar.daysActions.buttons.switchingToPreviousMonth.DATA_ATTRIBUTE_KEY]: ""
                    })
                      +Chevron__Leftward--YDF_Icon.Button--YDF-SVG_Icon
                      span.Button--YDF-Label= DateTimePicker__YDF.localization.dialog.topActionBar.dateSelectingMode.buttons.switchingToPreviousMonth.label

                  td
                    +Button--YDF({
                      geometricVariation: Button__YDF.GeometricVariations.small
                    })&attributes({
                      [DateTimePicker__YDF.DOM_AccessResources.dialog.topActionBar.daysActions.buttons.switchingToNextMonth.DATA_ATTRIBUTE_KEY]: ""
                    })
                      span.Button--YDF-Label= DateTimePicker__YDF.localization.dialog.topActionBar.dateSelectingMode.buttons.switchingToNextMonth.label
                      +Chevron__Rightward--YDF_Icon.Button--YDF-SVG_Icon

                  td
                    +Button--YDF({
                      label: DateTimePicker__YDF.localization.dialog.topActionBar.dateSelectingMode.buttons.switchingToMonthSelectingPanel.label,
                      geometricVariation: Button__YDF.GeometricVariations.small
                    })&attributes({
                      [DateTimePicker__YDF.DOM_AccessResources.dialog.topActionBar.reusableButtons.switchingToMonthSelectingPanel.DATA_ATTRIBUTE_KEY]: ""
                    })

                  td
                    +Button--YDF({
                      label: DateTimePicker__YDF.localization.dialog.topActionBar.dateSelectingMode.buttons.switchingToYearSelectingPanel.label,
                      geometricVariation: Button__YDF.GeometricVariations.small
                    })&attributes({
                      [DateTimePicker__YDF.DOM_AccessResources.dialog.topActionBar.reusableButtons.switchingToYearSelectingPanel.DATA_ATTRIBUTE_KEY]: ""
                    })

            when DateTimePicker__YDF.Matrices.months

              table.DateTimePicker--YDF-Dialog-TopActionBar-TwoPairsButtonsTable&attributes({
                [DateTimePicker__YDF.DOM_AccessResources.dialog.topActionBar.monthsActions.DATA_ATTRIBUTE_KEY]: ""
              })

                thead: tr

                  th(colspan="2")&attributes({
                    [DateTimePicker__YDF.DOM_AccessResources.dialog.topActionBar.monthsActions.columnsTitles.closestYears.DATA_ATTRIBUTE_KEY]: ""
                  })= DateTimePicker__YDF.localization.dialog.topActionBar.monthSelectingMode.labels.year

                  th(colspan="2")&attributes({
                    [DateTimePicker__YDF.DOM_AccessResources.dialog.topActionBar.monthsActions.columnsTitles.selectingPanels.DATA_ATTRIBUTE_KEY]: ""
                  })= DateTimePicker__YDF.localization.dialog.topActionBar.monthSelectingMode.labels.selectingPanels

                tbody: tr

                  td
                    +Button--YDF({
                      geometricVariation: Button__YDF.GeometricVariations.small
                    })&attributes({
                      [DateTimePicker__YDF.DOM_AccessResources.dialog.topActionBar.monthsActions.buttons.switchingToPreviousYear.DATA_ATTRIBUTE_KEY]: ""
                    })
                      +Chevron__Leftward--YDF_Icon.Button--YDF-SVG_Icon
                      span.Button--YDF-Label= DateTimePicker__YDF.localization.dialog.topActionBar.monthSelectingMode.buttons.switchingToPreviousYear.label

                  td
                    +Button--YDF({
                      geometricVariation: Button__YDF.GeometricVariations.small
                    })&attributes({
                      [DateTimePicker__YDF.DOM_AccessResources.dialog.topActionBar.monthsActions.buttons.switchingToNextYear.DATA_ATTRIBUTE_KEY]: ""
                    })
                      span.Button--YDF-Label= DateTimePicker__YDF.localization.dialog.topActionBar.monthSelectingMode.buttons.switchingToNextYear.label
                      +Chevron__Rightward--YDF_Icon.Button--YDF-SVG_Icon

                  td
                    +Button--YDF({
                      label: DateTimePicker__YDF.localization.dialog.topActionBar.monthSelectingMode.buttons.switchingToYearSelectingPanel.label,
                      geometricVariation: Button__YDF.GeometricVariations.small
                    })&attributes({
                      [DateTimePicker__YDF.DOM_AccessResources.dialog.topActionBar.reusableButtons.switchingToYearSelectingPanel.DATA_ATTRIBUTE_KEY]: ""
                    })

                  td
                    +Button--YDF({
                      label: DateTimePicker__YDF.localization.dialog.topActionBar.monthSelectingMode.buttons.switchingToDateSelectingPanel.label,
                      geometricVariation: Button__YDF.GeometricVariations.small
                    })&attributes({
                      [DateTimePicker__YDF.DOM_AccessResources.dialog.topActionBar.reusableButtons.switchingToDateSelectingPanel.DATA_ATTRIBUTE_KEY]: ""
                    })

            when DateTimePicker__YDF.Matrices.years

              table.DateTimePicker--YDF-Dialog-TopActionBar-TwoPairsButtonsTable&attributes({
                [DateTimePicker__YDF.DOM_AccessResources.dialog.topActionBar.yearsActions.DATA_ATTRIBUTE_KEY]: ""
              })

                thead: tr

                  th(colspan="2")&attributes({
                    [DateTimePicker__YDF.DOM_AccessResources.dialog.topActionBar.yearsActions.columnsTitles.adjacentYearsSets.DATA_ATTRIBUTE_KEY]: ""
                  })= DateTimePicker__YDF.localization.dialog.topActionBar.yearSelectingMode.labels.adjacentYearsSets

                  th(colspan="2")&attributes({
                    [DateTimePicker__YDF.DOM_AccessResources.dialog.topActionBar.yearsActions.columnsTitles.selectingPanels.DATA_ATTRIBUTE_KEY]: ""
                  })= DateTimePicker__YDF.localization.dialog.topActionBar.yearSelectingMode.labels.selectingPanels

                tbody: tr

                  td
                    +Button--YDF({
                      geometricVariation: Button__YDF.GeometricVariations.small
                    })&attributes({
                      [DateTimePicker__YDF.DOM_AccessResources.dialog.topActionBar.yearsActions.buttons.switchingToPreviousYearsSet.DATA_ATTRIBUTE_KEY]: ""
                    })
                      +Chevron__Leftward--YDF_Icon.Button--YDF-SVG_Icon
                      span.Button--YDF-Label= DateTimePicker__YDF.localization.dialog.topActionBar.yearSelectingMode.buttons.switchingToPreviousYearsSet.label

                  td
                    +Button--YDF({
                      geometricVariation: Button__YDF.GeometricVariations.small
                    })&attributes({
                      [DateTimePicker__YDF.DOM_AccessResources.dialog.topActionBar.yearsActions.buttons.switchingToNextYearsSet.DATA_ATTRIBUTE_KEY]: ""
                    })
                      span.Button--YDF-Label= DateTimePicker__YDF.localization.dialog.topActionBar.yearSelectingMode.buttons.switchingToNextYearsSet.label
                      +Chevron__Rightward--YDF_Icon.Button--YDF-SVG_Icon

                  td
                    +Button--YDF({
                      label: DateTimePicker__YDF.localization.dialog.topActionBar.yearSelectingMode.buttons.switchingToMonthSelectingPanel.label,
                      geometricVariation: Button__YDF.GeometricVariations.small
                    })&attributes({
                      [DateTimePicker__YDF.DOM_AccessResources.dialog.topActionBar.reusableButtons.switchingToMonthSelectingPanel.DATA_ATTRIBUTE_KEY]: ""
                    })

                  td
                    +Button--YDF({
                      label: DateTimePicker__YDF.localization.dialog.topActionBar.yearSelectingMode.buttons.switchingToDateSelectingPanel.label,
                      geometricVariation: Button__YDF.GeometricVariations.small
                    })&attributes({
                      [DateTimePicker__YDF.DOM_AccessResources.dialog.topActionBar.reusableButtons.switchingToDateSelectingPanel.DATA_ATTRIBUTE_KEY]: ""
                    })

        .DateTimePicker--YDF-Dialog-Header

          p.DateTimePicker--YDF-Dialog-Header-CurrentScopeLabel&attributes({
            [DateTimePicker__YDF.DOM_AccessResources.dialog.header.currentScopeLabel.DATA_ATTRIBUTE_KEY]: ""
          })

            case activeMatrix

              when DateTimePicker__YDF.Matrices.days

                | JAN

              when DateTimePicker__YDF.Matrices.months

                | 2025

          p.DateTimePicker--YDF-Dialog-Header-Guidance&attributes({
            [DateTimePicker__YDF.DOM_AccessResources.dialog.header.guidance.DATA_ATTRIBUTE_KEY]: ""
          })

            case activeMatrix

              when DateTimePicker__YDF.Matrices.days

                | Please select the day

              when DateTimePicker__YDF.Matrices.months

                | Please select the month

              when DateTimePicker__YDF.Matrices.years

                | Please select the year


        case activeMatrix

          when DateTimePicker__YDF.Matrices.days

            table.DateTimePicker--YDF-DaysMatrix
              thead
                tr
                  th.DateTimePicker--YDF-DayTitleCell.DateTimePicker--YDF-DayTitleCell__Holiday(scope="col") SUN
                  th.DateTimePicker--YDF-DayTitleCell(scope="col") MON
                  th.DateTimePicker--YDF-DayTitleCell(scope="col") TUE
                  th.DateTimePicker--YDF-DayTitleCell(scope="col") WED
                  th.DateTimePicker--YDF-DayTitleCell(scope="col") THR
                  th.DateTimePicker--YDF-DayTitleCell(scope="col") FRI
                  th.DateTimePicker--YDF-DayTitleCell.DateTimePicker--YDF-DayTitleCell__Holiday(scope="col") SAT
              tbody

                -
                  let dayNumberInMonth = 0;
                  const disabledButtonNumber = YDF.getRandomInteger({ minimalValue: 1, maximalValue: 31 })
                  const selectedButtonNumber = YDF.getRandomInteger({ minimalValue: 1, maximalValue: 31 })

                each weekData in initial6x7DaysMatrix

                  tr
                    each dayData in weekData

                      td: button.DateTimePicker--YDF-DaySelectingButton(
                        type="button"
                        disabled= dayNumberInMonth === disabledButtonNumber
                        class= dayNumberInMonth === selectedButtonNumber && "DateTimePicker-DaySelectingButton__Selected"
                      )= dayData.dayOfMonth

          when DateTimePicker__YDF.Matrices.months

            .DateTimePicker--YDF-MonthsMatrix
              each emptyArrayElement, index in new Array(MONTHS_COUNT_IN_YEAR)
                button.DateTimePicker--YDF-MonthSelectingButton(
                  type="button"
                )= index + 1


          when DateTimePicker__YDF.Matrices.years

            .DateTimePicker--YDF-YearsMatrix
              each emptyArrayElement in new Array(25)
                button.DateTimePicker--YDF-YearSelectingButton(
                  type="button"
                ) 2222


          when DateTimePicker__YDF.Matrices.hours

            table.DateTimePicker--YDF-HoursMatrix

              thead
                tr
                  th.DateTimePicker--YDF-HoursMatrix-HeaderCell(colspan="2" scope="col") A.M.
                  th.DateTimePicker--YDF-HoursMatrix-HeaderCell(colspan="2" scope="col") P.M.

              tbody
                each emptyArrayElement, index in new Array(6)
                  tr
                    td: button.DateTimePicker--YDF-HourSelectingButton(type="button")= index
                    td: button.DateTimePicker--YDF-HourSelectingButton(type="button")= index + 6
                    td: button.DateTimePicker--YDF-HourSelectingButton(type="button")= index
                    td: button.DateTimePicker--YDF-HourSelectingButton(type="button")= index + 6

          when DateTimePicker__YDF.Matrices.minutes

            .DateTimePicker--YDF-MinutesMatrix
              each emptyArrayElement, index in new Array(60)
                button.DateTimePicker--YDF-YearSelectingButton(
                  type="button"
                )= index


        .DateTimePicker--YDF-Dialog-BottomActionBar

          +Button--YDF({ label: "Unselect", geometricVariation: Button__YDF.GeometricVariations.small })


    template.DateTimePicker--YDF-DialogMountingPoint
