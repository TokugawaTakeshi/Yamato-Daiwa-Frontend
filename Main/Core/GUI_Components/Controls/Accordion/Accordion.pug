//- [ References ]
  + https://www.w3.org/WAI/ARIA/apg/patterns/accordion/
  + https://www.w3.org/WAI/ARIA/apg/patterns/accordion/examples/accordion/
mixin Accordion--YDF(properties, statesSimulations)

  -

    const {

      /** @type { string } */
      title,

      /**
       * @type { boolean }
       * @default false
       * */
      initiallyExpanded,

      /** @type { string | undefined } */
      headerTag: explicitlySpecifiedHeaderTag,

      /**
       * @type { boolean }
       * @default false
       * */
      mustUseHeadingTagDecidedByHeadingLevelsCoordinatorForHeader,

      /**
       * @type { ReadonlyArray<string> }
       * @default []
       * */
      panelAdditionalCSS_Classes,

      /**
       * @type { string }
       * @default Accordion__YDF.Themes.regular
       * */
      theme,

      /**
       * @type { boolean }
       * @default Accordion__YDF.areThemesCSS_ClassesCommon
       */
      areThemesCSS_ClassesCommon,

      /**
       * @type { string }
       * @default Accordion__YDF.GeometricVariations.regular
       */
      geometricVariation,

      /**
       * @type { string }
       * @default Accordion__YDF.DecorativeVariations.regular
       */
      decorativeVariation

    } =

        YDF.processObjectTypeParameterOfPugMixin({
          rawParameter: properties,
          parameterNumber: 1,
          parameterName: "properties",
          parameterPropertiesSpecification: Accordion__YDF.propertiesSpecification,
          mixinName: "Accordion--YDF"
        });


    /** @type { string } */
    const INSTANCE_ID = Accordion__YDF.generateInstanceID();

    /** @type { string } */
    const BUTTON_HTML_ID = `${ INSTANCE_ID }-BUTTON`;

    /** @type { string } */
    const PANEL_HTML_ID = `${ INSTANCE_ID }-PANEL`

    /** @type { Array<string> } */
    const rootElementModifierCSS_Classes =
        Accordion__YDF.getActualRootElementModifierCSS_Classes({
          theme,
          areThemesCSS_ClassesCommon,
          geometricVariation,
          decorativeVariation
        });

    /** @type { string } */
    const headerTag =
        explicitlySpecifiedHeaderTag ??
        mustUseHeadingTagDecidedByHeadingLevelsCoordinatorForHeader ?
            YDF.HeadingLevelsCoordinator.headingTagOfCurrentLevel :
            "div";


  .Accordion--YDF&attributes(attributes)(
    class=rootElementModifierCSS_Classes
  )

    #{ headerTag }.Accordion--YDF-Header
      +Button--YDF.Accordion--YDF-Button(
        aria-expanded=String(initiallyExpanded)
        aria-controls=PANEL_HTML_ID
        id=BUTTON_HTML_ID
      )&attributes({ [Accordion__YDF.DOM_AccessResources.button.DATA_ATTRIBUTE_KEY]: "" })

        +Triangle__Rightward__Filled--YDF_Icon.Button--YDF-SVG_Icon&attributes({
          [Accordion__YDF.DOM_AccessResources.button.icons.collapsed.DATA_ATTRIBUTE_KEY]: "",
          "aria-hidden": initiallyExpanded
        })

        +Triangle__Downward__Filled--YDF_Icon.Button--YDF-SVG_Icon&attributes({
          [Accordion__YDF.DOM_AccessResources.button.icons.expanded.DATA_ATTRIBUTE_KEY]: "",
          "aria-hidden": !initiallyExpanded
        })

        span.Button--YDF-Label= title

    .Accordion--YDF-Panel(
      id=PANEL_HTML_ID
      aria-labelledby=BUTTON_HTML_ID
      class=panelAdditionalCSS_Classes
      style={ display: initiallyExpanded ? "initial" : "none" }
    )&attributes({
      [Accordion__YDF.DOM_AccessResources.panel.DATA_ATTRIBUTE_KEY]: "",
      role: /^h[1-6]$/.test(headerTag) ? null : "region"
    })

      block
