mixin FilesUploader--YDF(properties, statesSimulations)

  -

    const {

      /** @type { string | undefined } */
      label,

      /** @type { string | undefined } */
      accessibilityGuidance,

      /** @type { string | undefined } */
      externalLabelHTML_ID,

      /** @type { string | undefined } */
      guidance,

      /** @type { string | Array<string> } */
      value,

      /**
       * @type { boolean }
       * @default false
       * */
      disabled,

      /**
       * @type { boolean }
       * @default false
       * */
      readonly,

      /**
       * @type { boolean }
       * @default false
       * */
      required,

      /**
       * @type { boolean }
       * @default false
       * */
      mustDisplayAppropriateBadgeIfInputIsRequired,

      /**
       * @type { boolean }
       * @default false
       * */
      mustDisplayAppropriateBadgeIfInputIsOptional,

      /**
       * @type { boolean }
       * @default false
       * */
      mustAddInvisibleBadgeForHeightEqualizingWhenNoBadge,

      /**
       * @type { number }
       * @default 1
       * */
      minimalFilesCount,

      /** @type { number } */
      maximalFilesCount,

      /** @type { Array<string> } */
      supportedFilesNamesExtensions__leadingDotsAreOptional,

      /**
       * @type { boolean }
       * @default false
       * */
      noFilePickingButton,

      /**
       * @type { boolean }
       * @default false
       * */
      noDragAndDropArea,

      /**
       * @type { boolean }
       * @default false
       * */
      noDragAndDropAreaOnTouchScreens,

      /** @type { string | undefined } */
      initialImageAspectRatio,

      /** @type { string | undefined } */
      instanceID_UniqueDynamicPart,

      /**
       * @type { FileUploader__YDF.Themes }
       * @default FileUploader__YDF.Themes.regular
       * */
      theme,

      /**
       * @type { boolean }
       * @default FileUploader__YDF.areThemesCSS_ClassesCommon
       * */
      areThemesCSS_ClassesCommon,

      /**
       * @type { FileUploader__YDF.GeometricVariations }
       * @default FileUploader__YDF.GeometricVariations.regular
       * */
      geometricVariation,

      /**
       * @type { FileUploader__YDF.DecorativeVariations }
       * @default FileUploader__YDF.DecorativeVariations.regular
       * */
      decorativeVariation,

      ...instanceID_DependentProperties

    } = YDF.processObjectTypeParameterOfPugMixin({
      rawParameter: properties,
      parameterNumber: 1,
      parameterName: "properties",
      parameterPropertiesSpecification: FilesUploader__YDF.propertiesSpecification,
      mixinName: "FilesUploader--YDF"
    });

    /** @type { string } */
    const INSTANCE_ID = FilesUploader.generateInstanceID(instanceID_UniqueDynamicPart);

    const {

      /** @type { string } */
      inputElementHTML_ID = `${ INSTANCE_ID }-INPUT`,

      /** @type { string } */
      labelElementHTML_ID = `${ INSTANCE_ID }-LABEL`

    } = instanceID_DependentProperties;

    const {

      /**
       * @type { boolean }
       * @default false
       * */
      filesProcessingStatuses,

      /**
       * @type { boolean | string }
       * @default false
       * */
      singleImagePreview,

      /**
       * @type { boolean }
       * @default false
       * */
      multipleImagesPreview,

      /**
       * @type { boolean }
       * @default false
       * */
      invalidInputHighlightingIfAnyValidationErrorsMessages,

      /**
       * @type { boolean }
       * @default false
       * */
      validValueHighlightingIfNoValidationErrorsMessages,

      /**
       * @type { boolean | ReadonlyArray<string> }
       * @default false
       * */
      validationErrorsMessages,

      /**
       * @type { boolean | ReadonlyArray<"IN_PROGRESS" | "FINISHED_BUT_INVALID" | "FINISHED_AND_VALID" | "MALFUNCTION"> }
       * @default false
       * */
      asynchronousValidationsStatuses

    } = YDF.processObjectTypeParameterOfPugMixin({
      rawParameter: statesSimulations,
      parameterNumber: 2,
      parameterName: "statesSimulations",
      parameterPropertiesSpecification: FilesUploader__YDF.statesSimulationsSpecification,
      mixinName: "FilesUploader--YDF"
    });

    /** @type { ReadonlyArray<string> } */
    const rootElementModifierCSS_Classes =

        FilesUploader.getActualRootElementModifierCSS_Classes({
          expanded,
          invalidInputHighlighting:
              invalidInputHighlightingIfAnyValidationErrorsMessages &&
              (validationErrorsMessages === true || validationErrorsMessages.length > 0),
          validValueHighlighting:
              validValueHighlightingIfNoValidationErrorsMessages &&
              (validationErrorsMessages === false || validationErrorsMessages.length === 0),
          theme,
          areThemesCSS_ClassesCommon,
          geometricVariation,
          decorativeVariation
        });

    /**
     * @param { string } value
     * @return { boolean }
     * */
    function isMVC_LikeValue(value) {
      return [

        /* Handlebars-like https://regex101.com/r/6uYwJM/1 */
        /^\s*\{\{\s*[a-zA-Z0-9_$]+\s*\}\}/u

      ].some(
        regularExpression => regularExpression.test(value)
      );
    }

    /** @type { string | undefined } */
    let singleImagePreviewURI;

    if (isString(singleImagePreview)) {
      singleImagePreviewURI = singleImagePreview;
    } else if (singleImagePreview === true) {
      singleImagePreviewURI = DummyImagesURIs.highAndNarrow;
    } else if (isString(value) && !isMVC_LikeValue(value)) {
      singleImagePreviewURI = value;
    }

    /** @type { ReadonlyArray<string> } */
    const supportedFilesNamesExtensionsWithoutLeadingDots =
        supportedFilesNamesExtensions__leadingDotsAreOptional.map(
          fileNameExtension =>
              YDF.removeSpecificCharacterFromCertainPosition({
                targetString: fileNameExtension,
                targetCharacter: ".",
                fromFirstPosition: true
              })
        );

    /* FIXME Not found to specify "accept all files" such as satisfy the HTML validator.
     *  Both "*" and *.*" has been treated as invalid. */
    /** @type { string } */
    const acceptAttributeValueForInputTag =
        supportedFilesNamesExtensionsWithoutLeadingDots.length > 0 ?
            `.${ supportedFilesNamesExtensionsWithoutLeadingDots.join(", .") }` : "*.*";


  +ValidatableControlShell--YDF(
    {

      label,
      guidance,

      required,
      mustDisplayAppropriateBadgeIfInputIsRequired,
      mustDisplayAppropriateBadgeIfInputIsOptional,
      mustAddInvisibleBadgeForHeightEqualizingWhenNoBadge,

      coreElementHTML_ID: inputElementHTML_ID,
      labelElementHTML_ID,

      theme: FilesUploader__YDF.selfAndChildrenComponentsThemesCorrespondence.validatableControlShell[theme],
      areThemesCSS_ClassesCommon,
      geometricVariation: FilesUploader__YDF.selfAndChildrenComponentsGeometricVariationsCorrespondence.
          validatableControlShell[geometricVariation],
      decorativeVariation: FilesUploader__YDF.selfAndChildrenComponentsDecorativeVariationsCorrespondence.
          validatableControlShell[decorativeVariation]

    },
    {
      invalidInputHighlightingIfAnyValidationErrorsMessages,
      validValueHighlightingIfNoValidationErrorsMessages,
      validationErrorsMessages,
      asynchronousValidationsStatuses
    }
  ).FilesUploader--YDF&attributes(attributes)(
    class=rootElementModifierCSS_Classes
    data-initial_value=value
    data-minimal_files_count=minimalFilesCount
    data-maximal_files_count=maximalFilesCount
  )

    if !noFilePickingButton

      -
        const filePickingButtonLabel = FilesUploader__YDF.localization.buttons.filePicking.
            buildLabel({ areMultipleFileAllowed: maximalFilesCount !== 1 })

      +Button--YDF({
        theme: FilesUploader__YDF.selfAndChildrenComponentsThemesCorrespondence.button[theme],
        geometricVariation: FilesUploader__YDF.selfAndChildrenComponentsGeometricVariationsCorrespondence.
            button[geometricVariation],
        decorativeVariation: FilesUploader__YDF.selfAndChildrenComponentsDecorativeVariationsCorrespondence.
            button[decorativeVariation],
      }).FilesUploader--YDF-FilePickingButton
        +FileAdding--YDF_Icon.Button--YDF-SVG_Icon
        span.Button--YDF-Label= filePickingButtonLabel


    if !noDragAndDropArea

      .FilesUploader--YDF-DragAndDropArea(
        tabindex="0",
        class=(noDragAndDropAreaOnTouchScreens ? "FilesUploader--YDF-DragAndDropArea__HiddenOnTouchScreens" : null)
      )
        +FileAdding--YDF_Icon.FilesUploader--YDF-DragAndDropArea-Icon
        p.FilesUploader--YDF-DragAndDropArea-Guidance=FilesUploader__YDF.localization.uploadSingleFileByDragAndDropGuidance


    if singleImagePreviewURI

      .FilesUploader--YDF-SingleImagePreviewer

        -

          const singleImagePreviewStyles = {
            ...YDF.isNotUndefined(initialImageAspectRatio) ? { "aspect-ratio": initialImageAspectRatio } : null
          };

        img.FilesUploader--YDF-SingleImagePreviewer-Image(
          src=singleImagePreviewURI
          alt=FilesUploader__YDF.localization.singleImagePreviewer.image.alternatingText
          style=singleImagePreviewStyles
        )

      if !required
        +Button--YDF.FilesUploader--YDF-SingleFileDeletingButton(
          aria-label=FilesUploader__YDF.localization.buttons.singleImageDeleting.accessibilityGuidance
        )
          +TrashCan__Filled--YDF_Icon.Button--YDF-SVG_Icon
          span.Button--YDF-Label= FilesUploader__YDF.localization.buttons.singleImageDeleting.label

    else if maximalFilesCount === 1

      template.FilesUploader--YDF-SingleImagePreviewerMountingPoint

    if multipleImagesPreview

      ul.FilesUploader--YDF-ImagesPreviewFlow(
        aria-label="Images preview"
      )

        each imageURI in Array.from(Object.values(YDF.DummyImagesURIs)).concat(Array.from(Object.values(YDF.DummyImagesURIs)))

          li.FilesUploader--YDF-PreviewCard

            .FilesUploader--YDF-PreviewCard-SizingAndDefaultBackgroundProvidingWrapper
              img.FilesUploader--YDF-PreviewCard-Image(
                src=imageURI
                alt="Image preview"
              )

            +Button--YDF({ label: "Delete" }).FilesUploader--YDF-PreviewCard-Button


    input.FilesUploader--YDF-HiddenInputElement(
      type="file"
      accept=acceptAttributeValueForInputTag
      multiple=(maximalFilesCount !== 1)
      required=required
      aria-label=accessibilityGuidance
      aria-labelledby=externalLabelHTML_ID
      id=inputElementHTML_ID
    )
