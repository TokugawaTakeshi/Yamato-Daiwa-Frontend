mixin Checkbox--YDF(properties)

  -

    const {

      /** @type { string | undefined } */
      label,

      /** @type { string | undefined } */
      externalLabelHTML_ID,

      /** @type { string | undefined } */
      HTML_Name,

      /** @type { string | undefined } */
      HTML_Value,

      /** @type { string | undefined } */
      instanceID_UniqueDynamicPart,

      /**
       * @type {
       *   {
       *     input?: string;
       *     label?: string;
       *   }
       *  }
       * */
      HTML_IDs,

      /**
       * @type { boolean }
       * @default false
       * */
      checked,

      /**
       * @type { boolean }
       * @default false
       * */
      disabled,

      /**
       * @type { boolean }
       * @default false
       * */
      readonly,

      /**
       * @type { string }
       * @default Checkbox.Themes.regular
       * */
      theme,

      /**
       * @type { boolean }
       * @default Checkbox.areThemesCSS_ClassesCommon
       */
      areThemesCSS_ClassesCommon,

      /**
       * @type { string }
       * @default Checkbox.GeometricVariations.regular
       */
      geometricVariation,

      /**
       * @type { Array<Checkbox.GeometricModifiers> }
       * @default []
       */
      geometricModifiers,

      /**
       * @type { string }
       * @default Checkbox.DecorativeVariations.regular
       * */
      decorativeVariation

    } = YDF.processObjectTypeParameterOfPugMixin({
      rawParameter: properties,
      parameterNumber: 1,
      parameterName: "properties",
      parameterPropertiesSpecification: Checkbox__YDF.propertiesSpecification,
      mixinName: "Checkbox--YDF"
    });

    /** @type { string } */
    const INSTANCE_ID = Checkbox__YDF.generateInstanceID(instanceID_UniqueDynamicPart);

    const {

      /** @type { string } */
      input: inputElementHTML_ID = `${ INSTANCE_ID }-INPUT`,

      /** @type { string } */
      label: labelElementHTML_ID = `${ INSTANCE_ID }-LABEL`

    } = HTML_IDs ?? {};


    const {

      /**
       * @type { boolean }
       * @default false
       * */
      invalidInputHighlightingIfAnyValidationErrorsMessages,

      /**
       * @type { boolean }
       * @default false
       * */
      validValueHighlightingIfNoValidationErrorsMessages,

      /**
       * @type { boolean | ReadonlyArray<string> }
       * @default false
       * */
      validationErrorsMessages,

      /**
       * @type { boolean | ReadonlyArray<"IN_PROGRESS" | "FINISHED_BUT_INVALID" | "FINISHED_AND_VALID" | "MALFUNCTION"> }
       * @default false
       * */
      asynchronousValidationsStatuses

    } = YDF.processObjectTypeParameterOfPugMixin({
      rawParameter: statesSimulations,
      parameterNumber: 2,
      parameterName: "statesSimulations",
      parameterPropertiesSpecification: Checkbox__YDF.statesSimulationsSpecification,
      mixinName: "Checkbox--YDF"
    });

    /** @type { Array<string> } */
    const rootElementModifierCSS_Classes =
        Checkbox__YDF.getActualRootElementModifierCSS_Classes({
          checked,
          disabled,
          readonly,
          theme,
          areThemesCSS_ClassesCommon,
          geometricVariation,
          decorativeVariation
        });


  +ValidatableControlShell--YDF(
    {

      label,

      required,
      mustDisplayAppropriateBadgeIfInputIsRequired,
      mustDisplayAppropriateBadgeIfInputIsOptional,
      mustAddInvisibleBadgeForHeightEqualizingWhenNoBadge,
      coreElementHTML_ID: inputElementHTML_ID,
      labelElementHTML_ID: labelElementHTML_ID,

      mainSlotWrapperAdditionalCSS_Classes: [ "Checkbox--YDF-ButtonLikeWrapper" ],

      theme: Checkbox__YDF.selfAndChildrenComponentsThemesCorrespondence.validatableControlShell[theme],
      areThemesCSS_ClassesCommon,
      geometricVariation: Checkbox__YDF.selfAndChildrenComponentsGeometricVariationsCorrespondence.
          validatableControlShell[geometricVariation],
      decorativeVariation: Checkbox__YDF.selfAndChildrenComponentsDecorativeVariationsCorrespondence.
          validatableControlShell[decorativeVariation]

    },
    {
      validationErrorsMessages,
      asynchronousValidationsStatuses
    }
  ).Checkbox--YDF&attributes(attributes)(
    class=rootElementModifierCSS_Classes
  )

    span.Checkbox--YDF-FrameForCheckmark(
      role="presentation"
    )
      span.Checkbox--YDF-Checkmark

    if label

      label.Checkbox--YDF-Label(
        for=inputElementHTML_ID
      )= label

    input.Checkbox--YDF-HiddenInputElement(
      type="checkbox"
      name=HTML_Name
      value=HTML_Value
      checked=checked
      disabled=disabled
      readonly=readonly
      id=inputElementHTML_ID
      aria-labelledby=externalLabelHTML_ID
    )
