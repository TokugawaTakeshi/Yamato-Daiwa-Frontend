      label,

      /** @type { string | undefined } */
      accessibilityGuidance,

      /** @type { string | undefined } */
      externalLabelHTML_ID,

      /** @type { string | undefined } */
      guidance,

      /** @type { DateTimePicker.Modes } */
      mode,

      /** @type { string | number } */
      value,

      /**
       * @type { boolean }
       * @default false
       * */
      disabled,

      /**
       * @type { boolean }
       * @default false
       * */
      readonly,

      /**
       * @type { boolean }
       * @default false
       * */
      required,

      /**
       * @type { boolean }
       * @default false
       * */
      mustDisplayAppropriateBadgeIfInputIsRequired,

      /**
       * @type { boolean }
       * @default false
       * */
      mustDisplayAppropriateBadgeIfInputIsOptional,

      /**
       * @type { boolean }
       * @default false
       * */
      mustAddInvisibleBadgeForHeightEqualizingWhenNoBadge,

      /** @type { string | undefined } */
      instanceID_UniqueDynamicPart,

