//- [ Reference ] https://www.w3.org/WAI/ARIA/apg/patterns/combobox/examples/combobox-autocomplete-both/
mixin ComboBox--YDF(properties, statesSimulations)

  -

    const {

      /** @type { string | undefined } */
      label,

      /** @type { string | undefined } */
      guidance,

      /** @type { string | undefined } */
      accessibilityGuidance,

      /** @type { string | undefined } */
      externalLabelHTML_ID,

      /**
       * @type { boolean }
       * @default false
       * */
      isMultiSelectionAllowed,

      /**
       * @type { boolean }
       * @default false
       * */
      disabled,

      /**
       * @type { boolean }
       * @default false
       * */
      readonly,

      /**
       * @type { boolean }
       * @default false
       * */
      required,

      /**
       * @type { boolean }
       * @default false
       * */
      mustDisplayAppropriateBadgeIfInputIsRequired,

      /**
       * @type { boolean }
       * @default false
       * */
      mustDisplayAppropriateBadgeIfInputIsOptional,

      /**
       * @type { boolean }
       * @default false
       * */
      mustAddInvisibleBadgeForHeightEqualizingWhenNoBadge

    } = YDF.processObjectTypeParameterOfPugMixin({
      rawParameter: properties,
      parameterNumber: 1,
      parameterName: "properties",
      parameterPropertiesSpecification: ComboBox.propertiesSpecification,
      mixinName: "ComboBox--YDF"
    });

    /** @type { string } */
    const INSTANCE_ID = ComboBox.generateComponentID();

    const {

      /** @type { string } */
      label: labelElementHTML_ID = `${ INSTANCE_ID }-LABEL`,

      /** @type { string } */
      inputElement: inputElementHTML_ID = `${ INSTANCE_ID }-INPUT_ELEMENT`,

      /** @type { string } */
      listBox: listBoxElementHTML_ID = `${ INSTANCE_ID }-LIST_BOX`

    } = HTML_IDs ?? {};

    /** @type { string } */
    const placeholder =
        isMultiSelectionAllowed ?
            ComboBox__YDF.localization.placeholders.selectingOfOneOrMultipleOptions :
            ComboBox__YDF.localization.placeholders.selectingOfOneOption;

    const {

      /**
       * @type { boolean }
       * @default false
       * */
      expanded,

      /**
       * @type { boolean }
       * @default false
       * */
      invalidInputHighlightingIfAnyValidationErrorsMessages,

      /**
       * @type { boolean }
       * @default false
       * */
      validValueHighlightingIfNoValidationErrorsMessages,

      /**
       * @type { boolean | ReadonlyArray<string> }
       * @default false
       * */
      validationErrorsMessages,

      /**
       * @type { boolean | ReadonlyArray<"IN_PROGRESS" | "FINISHED_BUT_INVALID" | "FINISHED_AND_VALID" | "MALFUNCTION"> }
       * @default false
       * */
      asynchronousValidationsStatuses

    } = YDF.processObjectTypeParameterOfPugMixin({
      rawParameter: statesSimulations,
      parameterNumber: 2,
      parameterName: "statesSimulations",
      parameterPropertiesSpecification: ComboBox.statesSimulationsSpecification,
      mixinName: "ComboBox--YDF"
    });

    /** @type { string } */
    let ariaLabelledbyAttributeValue;

    if (label) {
      ariaLabelledbyAttributeValue = labelElementHTML_ID;
    } else if (externalLabelHTML_ID) {
      ariaLabelledbyAttributeValue = externalLabelHTML_ID;
    }


  +ValidatableControlShell--YDF(
    {

      label,
      guidance,

      required,
      mustDisplayAppropriateBadgeIfInputIsRequired,
      mustDisplayAppropriateBadgeIfInputIsOptional,
      coreElementHTML_ID: inputElementHTML_ID,
      labelElementHTML_ID: labelElementHTML_ID

    },
    {
      invalidInputHighlightingIfAnyValidationErrorsMessages,
      validValueHighlightingIfNoValidationErrorsMessages,
      validationErrorsMessages,
      asynchronousValidationsStatuses
    }
  ).DropDownList--YDF&attributes(attributes)(class= rootElementModifierCSS_Classes)

    input.DropDownList--YDF-InputElement(
      type="text"
      role="combobox"
      id=inputElementHTML_ID
      aria-autocomplete="both"
      aria-expanded=expanded
      aria-controls=listBoxElementHTML_ID
    )

    button.DropDownList--YDF-Button(
      type="button"
      tabindex="-1"
      aria-label=ComboBox.localization.buttons.toggleExpanding
      aria-expanded=expanded
      aria-controls=listBoxElementHTML_ID
    )

    .DropDownList--YDF-ListBox(
      role="listbox"
      id=listBoxElementHTML_ID
      aria-label=ComboBox__YDF.localization.listBox.defaultAccessibilityGuidance
    )
