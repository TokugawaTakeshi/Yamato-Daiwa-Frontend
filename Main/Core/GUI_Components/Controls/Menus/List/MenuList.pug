mixin MenuList--YDF(properties, statesSimulations)

  -

    const {

      /**
       * @type { string }
       * @default MenuList__YDF.Themes.regular
       */
      theme,

      /**
       * @type { boolean }
       * @default MenuList__YDF.areThemesCSS_ClassesCommon
       */
      areThemesCSS_ClassesCommon,

      /**
       * @type { string }
       * @default MenuList__YDF.GeometricVariations.regular
       */
      geometricVariation,

      /**
       * @type { string }
       * @default MenuList__YDF.DecorativeVariations.regular
       * */
      decorativeVariation

    } = YDF.processObjectTypeParameterOfPugMixin({
      rawParameter: properties,
      parameterNumber: 1,
      parameterName: "properties",
      parameterPropertiesSpecification: MenuList__YDF.propertiesSpecification,
      mixinName: "MenuList--YDF"
    });

    /** @type { Array<string> } */
    const rootElementModifierCSS_Classes =
        YDF_ComponentsCoordinator.getActualRootElementModifierCSS_Classes(
            MenuList__YDF,
            {
              theme,
              areThemesCSS_ClassesCommon,
              geometricVariation,
              geometricModifiers,
              decorativeVariation,
              decorativeModifiers
            }
        );

  ul.MenuList--YDF&attributes(attributes)(class=rootElementModifierCSS_Classes)

    block


mixin MenuList-Item--YDF(properties)

  li.MenuList--YDF-Item

    +Button--YDF({
      label: properties.label,
      geometricModifiers: [ Button__YDF.GeometricModifiers.noRoundings ],
      decorativeModifiers: [
        Button__YDF.DecorativeModifiers.bordersDisguising,
        Button__YDF.DecorativeModifiers.noBackgroundInDefaultState
      ]
    }).MenuList--YDF-Button
