            })

            applyMixinStoredInObjectIfItIsNotNull--YDF(variation[state].label.customDeclarations)


      +provideDefaultSelectorWhenRootAndApply--YDF("." + ClosingButton--YDF.CSS_NAMESPACE)

        if (state == "defaultState")

          Declarations(state)

        else if (state == "hoverState")

          &:hover

