        targetObjectName: VARIATION_FULLY_QUALIFIED_NAME_FOR_LOGGING,
        extracts: {
          lineWidth: { dotSeparatedPath: "icon.lineWidth", required: true },
          lineThickness: { dotSeparatedPath: "icon.lineThickness", required: true }
        }
