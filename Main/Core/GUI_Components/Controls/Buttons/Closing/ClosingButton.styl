      &::after

        width lineWidth
        height lineThickness

        left: buildCalcExpression--YDF(
                "${ boxSizeHalfWidth } - ${ lineHalfWidth }",
                { boxSizeHalfWidth: boxSizeHalfWidth, lineHalfWidth: lineHalfWidth }
              )

        top: buildCalcExpression--YDF(
                "${ boxSizeHalfWidth } - ${ lineHalfThickness }",
                { boxSizeHalfWidth: boxSizeHalfWidth, lineHalfThickness: lineHalfThickness }
              )


