      lineWidth = cachedReusables.lineWidth
      lineHalfWidth = 0.5 * lineWidth

      lineThickness = cachedReusables.lineThickness
      lineHalfThickness = 0.5 * lineThickness

      boxSideWidth = sin(45deg) * lineWidth
      boxSizeHalfWidth = 0.5 * boxSideWidth


      width boxSideWidth
      height boxSideWidth


