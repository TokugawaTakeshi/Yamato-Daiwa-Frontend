  line-height lineHeight


  if extraSpaceCausedByLineHeightAtTopOrBottom != 0

    if isNotNull--YDF(paddingsWhichMustBeDecreasedInsteadOfAddingOfNegativeMargins)

      topPadding = getFirstNonNullArrayElement--YDF(
        arrayConstructor__POLYFILL--YDF(
