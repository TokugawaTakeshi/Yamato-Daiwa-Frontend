applyTextGeometryWithoutExtraSpaceCausedByLineHeight--YDF(compoundParameter, restParameters__MUST_NOT_BE...)

  validateObjectTypeParameter--YDF({
    mixinOrFunctionName: "applyTextGeometryWithoutExtraSpaceCausedByLineHeight--YDF",
    targetParameterNumber: 1,
