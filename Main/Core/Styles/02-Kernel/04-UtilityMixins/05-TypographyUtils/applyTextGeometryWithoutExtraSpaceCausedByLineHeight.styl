        margin-bottom: "calc(-1*%s)" % extraSpaceCausedByLineHeightAtTopOrBottom

    else

      &:before,
      &:after

        content ''
        display block


      &:before

        if isDimensionalOrDimensionlessQuantity--YDF(extraSpaceCausedByLineHeightAtTopOrBottom)

