{
  "name": "@yamato-daiwa/frontend",
  "version": "2.0.0-beta.12",
  "description": "Toolkit for the frontend development with Pug and Stylus pre-processors.",
  "keywords": [
    "frontend",
    "pug",
    "stylus"
  ],
  "author": {
    "name": "Takeshi Tokugawa",
    "email": "tokugawa.takesi@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://frontend.yamato-daiwa.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TokugawaTakeshi/yamato_daiwa-frontend.git"
  },
  "bugs": {
    "url": "https://github.com/TokugawaTakeshi/yamato_daiwa-frontend/issues",
    "email": "tokugawa.takesi@gmail.com"
  },
  "files": [
    "GUI_Components",
    "!GUI_Components/**/*.ts",
    "!GUI_Components/**/*.template.pug",
    "LogicDistributable",
    "Markup",
    "!Markup/Source",
    "PagesTemplates",
    "!PagesTemplates/StaticPreviewAnywherePage/StaticPreviewAnywherePage.styl",
    "Styles",
    "Functionality.pug",
    "Functionality.styl",
    "GUI_Components.pug",
    "GUI_Components.styl"
  ],
  "module": "./LogicDistributable/index.js",
  "types": "./LogicDistributable/index.d.ts",
  "sideEffects": false,
  "dependencies": {
    "clipboard": "2.0.11",
    "fundamental-constants": "0.9.0",
    "prismjs": "1.30.0"
  },
  "peerDependencies": {
    "@yamato-daiwa/es-extensions": "~1.9.0",
    "@yamato-daiwa/es-extensions-browserjs": "~1.9.0"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/prismjs": "1.26.6",
    "@yamato-daiwa/automation": "0.10.0-alpha.3",
    "@yamato-daiwa/es-extensions": "1.9.3",
    "@yamato-daiwa/es-extensions-browserjs": "1.9.3",
    "@yamato-daiwa/style_guides": "0.14.5",
    "rimraf": "6.1.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "scripts": {
    "Audit Production Dependencies Only": "npm audit --omit=dev",
    "Check Types": "tsc --noEmit",
    "Lint": "eslint",
    "Build Pug Auxiliaries for Production": "yda build --selectiveExecution PugAuxiliaries --mode PRODUCTION && tsx Markup/InlineECMAScript/PugAuxiliariesOutputFileGenerator.ts",
    "Building Logic for Production": "rimraf LogicDistributable && yda build --selectiveExecution Logic --mode PRODUCTION && tsc --project tsconfig.declarations.json --declaration --emitDeclarationOnly --outDir LogicDistributable",
    "Production Building of Anywhere Page Template Styles": "yda build --selectiveExecution StaticPreviewAnywherePage --mode PRODUCTION",
    "Tests": "yda build --selectiveExecution StylesAndComponentsTesting --mode LOCAL_DEVELOPMENT",
    "Start Workbenches": "yda build --selectiveExecution Workbenches --mode LOCAL_DEVELOPMENT",
    "Realize Alpha": "npm publish --tag alpha",
    "Realize Beta": "npm publish --tag beta",
    "Realize RC": "npm publish --tag rc",
    "Print Project Structure": "wsl tree -I \".git|.idea|node_modules|LogicDistributable|Build\" || tree -I \".git|.idea|node_modules|LogicDistributable|Build\""
  },
  "allowScripts": {
    "core-js@2.6.12": true,
    "es5-ext@0.10.64": true,
    "esbuild@0.28.2": true,
    "gifsicle@5.3.0": true,
    "husky@4.3.8": true,
    "mozjpeg@6.0.1": true,
    "optipng-bin@6.0.0": true,
    "pngquant-bin@6.0.1": true,
    "puppeteer@24.43.0": true,
    "vnu-jar@26.3.10": true
  },
  "funding": "https://github.com/TokugawaTakeshi/Yamato-Daiwa-Frontend?sponsor=1"
}
