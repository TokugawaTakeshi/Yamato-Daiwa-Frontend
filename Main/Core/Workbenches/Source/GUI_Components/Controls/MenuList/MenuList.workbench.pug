extends ../../../../../PagesTemplates/RegularWebPageTemplate.pug


block append Metadata

  -

    RegularWebPageTemplate__YDF.configure({
      metadata: {
        title: "MenuList Component Development"
      },
      stylesSheetsURIs: [ "@Workbenches/GUI_Components/Controls/MenuList/MenuList.workbench" ]
    });


block append Requirements

  include ../../../../../GUI_Components.pug


block append PageContent

  +MenuList--YDF({
    theme: MenuList__YDF.Themes.regular,
    geometricVariation: MenuList__YDF.GeometricVariations.regular,
    decorativeVariation: MenuList__YDF.DecorativeVariations.regular
  })

    +MenuList-Item--YDF({ label: "First item" })
    +MenuList-Item--YDF({ label: "Second item" })
    +MenuList-Item--YDF({ label: "Third item" })
