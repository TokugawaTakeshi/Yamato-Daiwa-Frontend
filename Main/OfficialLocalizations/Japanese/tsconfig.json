{
  "compilerOptions": {

    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,

    "removeComments": true,
    "declaration": true,

    "rootDir": ".",
    "outDir": "LogicDistributable",

  },

  "include": [
    "index.ts",
    "GUI_Components"
  ]

}
