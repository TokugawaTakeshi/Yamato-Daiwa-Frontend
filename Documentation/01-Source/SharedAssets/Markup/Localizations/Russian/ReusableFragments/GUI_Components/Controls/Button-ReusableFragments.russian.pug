//- ━━━ Pug Mixin or Class Synopsis ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
mixin ButtonComponent-MinimalExampleDescription(properties)

  -

    const { framework } = properties ?? {};

    const exampleURI = (() => {

      switch (framework) {

        case SupportedFrameworks.vue:
            return "$Demos:Vue/GUI_Components/Controls/Buttons/Plain/ButtonGalleryPage-Minimal.html"

        default:
            return "$Demos:CorePackage/GUI_Components/Controls/Buttons/Plain/ButtonGalleryPage-Minimal.html"

      }

    })();

    const exampleTitle = [
      "Примеры отображения компонента «Button» (библиотека: «Yamato Daiwa Frontend",
      ...isNotUndefined(framework) ? [ ` ${ toUpperCamelCase(framework) }` ] : [],
      "», сокращённо: «YDF",
      ...isNotUndefined(framework) ? [ ` ${ toUpperCamelCase(framework) }` ] : [],
      "»."
    ].join("");

  +WebPageViewer--YDF({ URI: exampleURI, title: exampleTitle })

  +CodeViewer--YDF

    +CodeViewer-TabPanel--YDF({ codeLanguage: CodeViewer__YDF.SupportedCodesLanguages.Pug })

      +CodeViewer-PartialListing--YDF

        if framework

          :code_listing--yda

            <Button/>

        else

          | +Button--YDF
      +CodeViewer-Explanation--YDF.
        Использовать компонент #[+ImportantEntity__Code--YDID Button] без&nbsp;указания #[+Term--YDID свойств] можно,
          однако согласно требованиям #[+Term--YDID доступности], у кнопки должно быть
          #[+Keyword--YDID либо] #[+Keyphrase--YDID включающее текст] дочернее содержимое, либо указан один из
          следующих #[+Term--YDID атрибутов]: #[+ImportantEntity__Code--YDID aria-label],
          #[+ImportantEntity__Code--YDID aria-labelledby], #[+ImportantEntity__Code--YDID title].
        Поэтому в данном случае хотя выходной #[+Term--YDID HTML-код] и будет сгенерирован, использование компонента
          без&nbsp;указания дополнительных #[+Term--YDID свойств], #[+Term--YDID HTML-атрибутов] или дочернего
          содержимого крайне #[+Keyword--YDID не]&nbsp;рекомендуется.

      +CodeViewer-PartialListing--YDF

        if framework

          :code_listing--yda

            <Button>Click</Button>

        else

          | +Button--YDF({ label: "Click" })
      +CodeViewer-Explanation--YDF.
        Если не&nbsp;указано #[+Term--YDID свойства] #[+ImportantEntity__Code--YDID HTML_Type], то будет сгенерирован
          #[+Term--YDID тэг] #[+ImportantEntity__Code--YDID button] с #[+Term--YDID атрибутом]
          #[+ImportantEntity__Code--YDID type="button"] и текстовым содержимым, указанным через
          #[+Term--YDID свойство] #[+ImportantEntity__Code--YDID label].
        Такая кнопка #[+Keyword--YDID никак] #[+Keyword__Contrast--YDID не]&nbsp;взаимодействует с
          #[+Term--YDID HTML-формой], если таковая имеется в качестве родительского элемента.

      +CodeViewer-PartialListing--YDF: :code_listing--yda
        +Button--YDF({
          label: "Documentation",
          URI: "https://frontend.yamato-daiwa.com/"
        })
      +CodeViewer-Explanation--YDF.
        Если Вы хотите, чтобы был сгенерирован код ссылки #[+Keyphrase--YDID с внешнем видом кнопки], то укажите
          #[+Term--YDID свойство] #[+ImportantEntity--YDID URI].
        Будьте осторожны, если для Вашего сайта или приложения актуальна #[+Term--YDID поисковая оптимизация],
          поскольку такая #[+Term--YDID ссылка] может отдать часть рейтинга тому сайту или приложению, который
          соответствует указанному #[+ImportantEntity--YDID URI].
        Можно попытаться смягчить последствия, указав #[+Term--YDID свойство]
          #[+ImportantEntity__Code--YDID mustRequestNotFollowLinkForCrawlingToSearchEngine], что приведёт к добавлению
          #[+Term--YDID атрибута] #[+ImportantEntity__Code--YDID rel] с нужными значениями, однако, как это следует
          из названия #[+Term--YDID свойства], это лишь «просьба» поисковому роботу не&nbsp;учитывать эту ссылку,
          а реальное поведение робота не&nbsp;под нашим контролем.

      +CodeViewer-PartialListing--YDF: :code_listing--yda
        +Button--YDF({
          label: "Documentation",
          HTML_Type: Button__YDF.HTML_Types.inputSubmit
        })
      +CodeViewer-Explanation--YDF

        p.Article-Paragraph.
          Если имеется #[+Keyword--YDID родительский] элемент #[+ImportantEntity__Code--YDID form], то согласно
            требованиям #[+Term--YDID доступности], кнопка отправки данных должна быть либо #[+Term--YDID тэгом]
            #[+ImportantEntity__Code--YDID input] со #[+Term--YDID атрибутом]
            #[+ImportantEntity__Code--YDID type="submit"], либо
            #[+Term--YDID тэгом] #[+ImportantEntity__Code--YDID button] с этим же #[+Term--YDID атрибутом].
          В зависимости от указанного значения #[+Term--YDID свойства] #[+ImportantEntity__Code--YDID HTML_Type] будет
            сгенерирована следующая комбинация #[+Term--YDID тэгов] и #[+Term--YDID атрибутов]:

        dl.Article-DescriptionList

          dt Button__YDF.HTML_Types.regular
          dd #[+ImportantEntity__Code--YDID &lt;button type="button"&gt;&lt;button&gt;] (по умолчанию)

          dt Button__YDF.HTML_Types.submit
          dd #[+ImportantEntity__Code--YDID &lt;button type="submit"&gt;&lt;button&gt;]

          dt Button__YDF.HTML_Types.inputButton
          dd #[+ImportantEntity__Code--YDID &lt;input type="button"/&gt;]

          dt Button__YDF.HTML_Types.inputSubmit
          dd #[+ImportantEntity__Code--YDID &lt;input type="submit"/&gt;]

          dt Button__YDF.HTML_Types.inputReset
          dd #[+ImportantEntity__Code--YDID &lt;input type="reset"/&gt;]

        p.Article-Paragraph.
          В современности отправка данных часто осуществляется с помощью #[+ImportantEntity--YDID JavaScript] и
            технологии #[+ImportantEntity--YDID AJAX], а тэг #[+ImportantEntity__Code--YDID form] используется лишь для
            понятной семантики и #[+Term--YDID доступности].
          #[+Keyphrase--YDID В таких случаях] можно обойтись только #[+Keyword--YDID двумя] типами:
            #[+ImportantEntity__Code--YDID Button__YDF.HTML_Types.regular] (#[+Keyword--YDID не]&nbsp;обязательно явно
            указывать, так это значение по умолчанию) и #[+ImportantEntity__Code--YDID Button__YDF.HTML_Types.submit].
