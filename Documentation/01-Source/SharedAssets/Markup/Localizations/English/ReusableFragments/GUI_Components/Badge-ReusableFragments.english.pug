//- ━━━ Abstract ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
mixin BadgeComponent-Abstract

  p.Article-Paragraph.
    In #[+ImportantEntity--YDID YDF], the #[+DefinableTerm--YDID badge] in the #[+Keyword--YDID informational]
      #[+Keyword__Contrast--YDID non-interactive] component displaying inside the rectangle with rounded corners or
      without them the word or other characters sequence like date and/or time.
    It is possible to add the icon but note that it is the #[+Keyword--YDID supplement] for the label,
      &nbsp;#[+Keyword--YDID not] the substitution for the label.

  p.Article-Paragraph.
    In UI/UX frameworks the similar component could have another names such as #[+Term--YDID Chip], #[+Term--YDID Pill]
      or #[+Term--YDID Tag].
    There is #[+Keyword--YDID no]&nbsp;the official definitions for the components, moreover some frameworks defines
      them by own, and #[+ImportantEntity--YDID YDF] which is&nbsp;not intended to be considered as framework reserves
      the right to do so.

  p.Article-Paragraph.
    #[+Keyphrase--YDID In #[+ImportantEntity--YDID YDF],] the #[+Term--YDID badge] designed as exactly how
      #[+Keyword--YDID non-interactive] component which #[+Keyword--YDID just] #[+Keyword__Contrast--YDID displaying]
      the information.
    It should be distinguished from visually similar interactive components such the ones could be used as button,
      or could be deleted by click the dedicated internal button, etc.
    Also, the #[+Term--YDID YDF badge] supports the two labels: key and value that is important when, for example,
      it is unobvious by the calendar the date of which event exactly is displaying.


