        "$CommonStyles",
        "$LayoutsStyles/TwoColumns/TwoColumnsLayout.css",
        "$PreMadesStyles",
        "@CustomizedExternalComponents"
      ]
    });

    RoutingEmulator.setCurrentRoute("coreLibrary.GUI_Components.controls.buttons.plain");

    LanguageDropDownList__YDF_DK.setLinks({
      english: routing.english.coreLibrary.$children.GUI_Components.$children.controls.$children.buttons.$children.plain.$URI,
