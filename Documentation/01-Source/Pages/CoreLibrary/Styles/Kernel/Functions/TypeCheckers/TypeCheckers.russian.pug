    p.Article-Paragraph.
      В отличие от большинства языков программирования #[+ImportantEntity--YDID Stylus], будучи
        #[+Term--YDID CSS-препроцессором], оперирует не&nbsp;просто с #[+Term--YDID числами], а с
        #[+Term--YDID величинами] — #[+Term__Contrast--YDID размерными] (#[+Term__Contrast--YDID «dimensional quantity»])
        или же #[+Term__Contrast--YDID безразмерными] (#[+Term__Contrast--YDID «dimensionless quantity»]).
      Для #[+Keyword--YDID обоих] типов #[+Term--YDID величин] #[+ImportantEntity__Code--YDID typeof()] вернёт
        #[+ImportantEntity--YDID "unit"], потому когда наличие или отсутствие размерности критично, потребуется
        дополнительная проверка.
      Для подобных целей среди приведённых ниже #[+Term--YDID функций] есть
        #[+ImportantEntity__Code--YDID isDimensionalQuantity] и #[+ImportantEntity__Code--YDID isDimensionlessQuantity],
        а #[+ImportantEntity__Code--YDID isDimensionalOrDimensionlessQuantity] хотя и является
        #[+Keyword--YDID эквивалентом] #[+ImportantEntity__Code--YDID typeof(x) == "unit"], имеет имя, из прямого перевода
        которого чётко понятно, что #[+ImportantEntity__Code--YDID true] будет возвращено как для
        #[+Term--YDID размерных величин], #[+Keyword--YDID так] #[+Keyword__Contrast--YDID и]
        #[+Term--YDID безразмерных величин].


    //- ╍╍╍ `isDimensionalOrDimensionlessQuantity` ╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍
    +Heading--YDF({
      level: 3,
      innerHTML: localizedSectioning.quantities.$children.isDimensionalOrDimensionlessQuantity.$heading,
      HTML_ID: localizedSectioning.quantities.$children.isDimensionalOrDimensionlessQuantity.$anchor
    }).Article-Heading3

    p.Article-Paragraph.
      Возвращает #[+ImportantEntity__Code--YDID true] #[+Keyphrase--YDID тогда и только тогда], когда
        #[+Term--YDID значением] #[+Term__Contrast--YDID параметра] является #[+Keyword--YDID размерная]
        #[+Keyword__Contrast--YDID или] #[+Keyword--YDID безразмерная]　#[+Term--YDID величина], в противном случае
        возвращает #[+ImportantEntity__Code--YDID false].
      Работает #[+Keyphrase--YDID так же], как и #[+ImportantEntity__Code--YDID typeof(value) == "unit"], и хотя имеет
        длинное имя, разрешает неоднозначность по поводу того, на #[+Keyword--YDID размерную] или безразмерную
        #[+Keyword__Contrast--YDID величину] осуществляется проверка (в данном случае на #[+Keyword--YDID обе]).

    +CodeViewer--YDF
      +CodeViewer-Listing--YDF({ codeLanguage: CodeViewer__YDF.SupportedCodesLanguages.Stylus }): :code_listing--yda
        log(isDimensionalOrDimensionlessQuantity(2px)) // true
        log(isDimensionalOrDimensionlessQuantity(2))   // true


    //- ╍╍╍ `isDimensionalQuantity` ╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍
    +Heading--YDF({
      level: 3,
      innerHTML: localizedSectioning.quantities.$children.isDimensionalQuantity.$heading,
      HTML_ID: localizedSectioning.quantities.$children.isDimensionalQuantity.$anchor
    }).Article-Heading3

    p.Article-Paragraph.
      Возвращает #[+ImportantEntity__Code--YDID true] #[+Keyphrase--YDID тогда и только тогда], когда
        #[+Term--YDID значением] #[+Term__Contrast--YDID параметра] является #[+Keyword--YDID размерная]
        #[+Term--YDID величина], в противном случае возвращает #[+ImportantEntity__Code--YDID false], при этом
        #[+Keyword--YDID необходимо] указать через #[+Keyword--YDID второй] #[+Term--YDID параметр], считать ли
        #[+ImportantEntity--YDID 0] #[+Keyword--YDID размерной] #[+Term--YDID величиной].
      Как известно из основ #[+ImportantEntity--YDID CSS], этот язык описания стилей #[+Keyword--YDID позволяет]
        #[+Keyword__Contrast--YDID опускать] #[+Term--YDID единицы изменения], если величина равна
        #[+ImportantEntity--YDID 0] (другими словами, #[+ImportantEntity--YDID 0] #[+Keyword--YDID эквивалентен]
        #[+ImportantEntity--YDID 0px], #[+ImportantEntity--YDID 0rem] и
        сочетаниям #[+ImportantEntity--YDID 0] с #[+Keyword--YDID любым] #[+Keyword__Contrast--YDID другими]
        #[+Term--YDID единицами измерения],
        #[+Keyphrase--YDID поддерживаемыми на данный момент в #[+ImportantEntity--YDID CSS]]).

    +CodeViewer--YDF
      +CodeViewer-Listing--YDF({ codeLanguage: CodeViewer__YDF.SupportedCodesLanguages.Stylus }): :code_listing--yda
        isDimensionalQuantity(2px, "MUST_CONSIDER_DIMENSIONLESS_ZERO_AS_DIMENSIONAL_QUANTITY") // true
        isDimensionalQuantity(2, "MUST_CONSIDER_DIMENSIONLESS_ZERO_AS_DIMENSIONAL_QUANTITY")   // false
        isDimensionalQuantity(0, "MUST_CONSIDER_DIMENSIONLESS_ZERO_AS_DIMENSIONAL_QUANTITY")   // true
        isDimensionalQuantity(0, "MUST_NOT_CONSIDER_DIMENSIONLESS_ZERO_AS_DIMENSIONAL_QUANTITY") // false

    +AdmonitionBlock--YDF({
