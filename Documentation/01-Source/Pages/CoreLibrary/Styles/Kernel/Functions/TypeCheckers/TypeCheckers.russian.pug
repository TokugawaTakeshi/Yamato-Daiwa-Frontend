block append Metadata

  -

    const {
      $heading: pageTopHeading,
      $sectioning: localizedSectioning
    } = localizedRouting.coreLibrary.$children.styles.$children.kernel.$children.functions.$children.typeCheckers;

    RegularWebPageTemplate__YDF.configure({
      metadata: {
        title: buildHTML_PageTitle(pageTopHeading),
        description:
          "Библиотека «Yamato Daiwa Frontend» (сокращённо: «YDF») для фронтенд-разработки предлагает Stylus-функции " +
            "для проверки типов значений, позволяющие получить больше информации, чем стандартная функция «typeof»."
      },
      stylesSheetsURIs: [
        "$CommonStyles",
        "$LayoutsStyles/TwoColumns/TwoColumnsLayout.css",
        "$PreMadesStyles",
        "@CustomizedExternalComponents"
      ]
    });

    RoutingEmulator.setCurrentRoute("coreLibrary.styles.kernel.functions.typeCheckers");

    LanguageDropDownList__YDF_DK.setLinks({
      english: routing.english.coreLibrary.$children.styles.$children.kernel.$children.functions.$children.
          typeCheckers.$URI,
      japanese: routing.japanese.coreLibrary.$children.styles.$children.kernel.$children.functions.$children.
          typeCheckers.$URI
    });


