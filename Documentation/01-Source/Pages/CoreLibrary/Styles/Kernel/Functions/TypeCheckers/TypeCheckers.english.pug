        isDimensionlessQuantity(value)

          return typeof(value) == "unit" && isEmptyString(unit(value))


    //- ╍╍╍ `isNonEmptyString` ╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍
    +Heading--YDF({
      level: 3,
      innerHTML: localizedSectioning.strings.$children.isNonEmptyString.$heading,
      HTML_ID: localizedSectioning.strings.$children.isNonEmptyString.$anchor
    }).Article-Heading3

    p.Article-Paragraph.
      Returns #[+ImportantEntity__Code--YDID true] #[+Keyphrase--YDID if and only if] the #[+Term--YDID parameter's]
        #[+Term__Contrast--YDID value] is a #[+Keyword--YDID non-empty] #[+Term--YDID string], otherwise returns
        #[+ImportantEntity__Code--YDID false].

    +AdmonitionBlock--YDF({
        SVG_Icon: true,
        geometricVariation: AdmonitionBlock__YDF.GeometricVariations.stickyNoteLike,
        decorativeVariation: AdmonitionBlock__YDF.DecorativeVariations.warning
    }).
      #[+ImportantEntity__Code--YDID isNonEmptyString(X)] is #[+Keyword--YDID not]&nbsp;equivalent to
        #[+ImportantEntity__Code--YDID !isEmptyString(X)] because in the #[+Keyword--YDID first] case
        #[+ImportantEntity__Code--YDID true] will be returned #[+Keyword--YDID only] when the #[+Term--YDID string] is
        #[+Keyword__Contrast--YDID non-empty] while in the #[+Keyword--YDID second] case #[+Keyword--YDID also] when
        the value is a #[+Keyword--YDID non-string].

    p.Article-Paragraph.
      The usage of #[+ImportantEntity__Code--YDID !isNonEmptyString(X)] is rather demanded.
      Although the double negation may confuse, this filtering out of everything #[+Keyword--YDID except]
        #[+Keyword__Contrast--YDID non-empty] #[+Term--YDID strings] functionality may be useful.


    //- ╍╍╍ `isString` ╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍
    +Heading--YDF({
      level: 3,
      innerHTML: localizedSectioning.strings.$children.isString.$heading,
      HTML_ID: localizedSectioning.strings.$children.isString.$anchor
    }).Article-Heading3

    p.Article-Paragraph.
      Returns #[+ImportantEntity__Code--YDID true] if the #[+Term--YDID parameter's] #[+Term__Contrast--YDID value] is a
        #[+Term--YDID string] (#[+Keyword--YDID either] empty #[+Keyword--YDID or] no), otherwise returns
        #[+ImportantEntity__Code--YDID false].
      The #[+Keyword--YDID shorthand] of #[+ImportantEntity__Code--YDID typeof(value) == "string"].


    //- ┅┅┅ Quantities ┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅
    +Heading--YDF({
      level: 2,
      text: localizedSectioning.quantities.$heading,
      HTML_ID: localizedSectioning.quantities.$anchor
    }).Article-Heading2

    p.Article-Paragraph.
      Unlike the majority of programming languages, #[+ImportantEntity--YDID Stylus] being the
        #[+Term--YDID CSS preprocessor] work with #[+Keyword--YDID dimensional] and #[+Keyword--YDID dimensionless]
        #[+Keyword__Contrast--YDID quantities], not&nbsp;only with plain numbers.
      For #[+Keyword--YDID both] of them #[+ImportantEntity__Code--YDID typeof()] check will return
        #[+ImportantEntity--YDID "unit"] thus when the dimension presence or absence is critical, the additional
        check will required.
      For such target, among the following #[+Term--YDID functions] there are
        #[+ImportantEntity__Code--YDID isDimensionalQuantity] and #[+ImportantEntity__Code--YDID isDimensionlessQuantity]
        ones.
      Also, although the а #[+ImportantEntity__Code--YDID isDimensionalOrDimensionlessQuantity] is the
        #[+Keyword--YDID equivalent] of #[+ImportantEntity__Code--YDID typeof(x) == "unit"], it has the name from which
        it is clear that #[+ImportantEntity__Code--YDID true] will be returned for #[+Keyword--YDID both]
        #[+Term--YDID dimensional] and #[+Term--YDID dimensionless quantities].


    //- ╍╍╍ `isDimensionalOrDimensionlessQuantity` ╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍
    +Heading--YDF({
      level: 3,
      innerHTML: localizedSectioning.quantities.$children.isDimensionalOrDimensionlessQuantity.$heading,
      HTML_ID: localizedSectioning.quantities.$children.isDimensionalOrDimensionlessQuantity.$anchor
    }).Article-Heading3

    p.Article-Paragraph.
      Returns #[+ImportantEntity__Code--YDID true] #[+Keyphrase--YDID if and only if] the #[+Term--YDID parameter's]
       #[+Term__Contrast--YDID value] is #[+Keyword--YDID either] #[+Keyword__Contrast--YDID dimensional]
       #[+Keyword--YDID or] #[+Keyword__Contrast--YDID dimensionless] #[+Term--YDID quantity], otherwise returns
       #[+ImportantEntity__Code--YDID false].
      Works #[+Keyphrase--YDID same as] #[+ImportantEntity__Code--YDID typeof(value) == "unit"] and, although has the
        long name, disambiguates about for #[+Term--YDID dimensional] or #[+Term--YDID dimensionless quantity]
        check performed (in this case for #[+Keyword--YDID both]).

    +CodeViewer--YDF
      +CodeViewer-Listing--YDF({ codeLanguage: CodeViewer__YDF.SupportedCodesLanguages.Stylus }): :code_listing--yda
        log(isDimensionalOrDimensionlessQuantity(2px)) // true
        log(isDimensionalOrDimensionlessQuantity(2))   // true


    //- ╍╍╍ `isDimensionalQuantity` ╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍
    +Heading--YDF({
      level: 3,
      innerHTML: localizedSectioning.quantities.$children.isDimensionalQuantity.$heading,
      HTML_ID: localizedSectioning.quantities.$children.isDimensionalQuantity.$anchor
    }).Article-Heading3

    p.Article-Paragraph.
      Returns #[+ImportantEntity__Code--YDID true] if the #[+Term--YDID parameter's] #[+Term__Contrast--YDID value] is a
        #[+Keyword--YDID dimensional] #[+Term--YDID quantity], otherwise returns #[+ImportantEntity__Code--YDID false],
        herewith it is #[+Keyword--YDID required] to specify via #[+Keyword--YDID second] parameter must the
        #[+Term--YDID function] consider the #[+ImportantEntity__Code--YDID 0] as #[+Keyword--YDID dimensional]
        #[+Term--YDID quantity] or no.
      As known from #[+ImportantEntity--YDID CSS] fundamentals, this styles definition language #[+Keyword--YDID allows]
        to #[+Keyword__Contrast--YDID omit] the units if the #[+Term--YDID quantity] is
        #[+ImportantEntity__Code--YDID 0] (by other words, #[+ImportantEntity--YDID 0] is #[+Keyword--YDID equivalent] to
        #[+ImportantEntity--YDID 0px], #[+ImportantEntity--YDID 0rem] and combinations of #[+ImportantEntity--YDID 0]
        with #[+Keyword--YDID any] #[+Keyword__Contrast--YDID other] #[+Term--YDID units]
        #[+Keyphrase--YDID currently supported by #[+ImportantEntity--YDID CSS]]).

    +CodeViewer--YDF
      +CodeViewer-Listing--YDF({ codeLanguage: CodeViewer__YDF.SupportedCodesLanguages.Stylus }): :code_listing--yda
        isDimensionalQuantity(2px, "MUST_CONSIDER_DIMENSIONLESS_ZERO_AS_DIMENSIONAL_QUANTITY") // true
        isDimensionalQuantity(2, "MUST_CONSIDER_DIMENSIONLESS_ZERO_AS_DIMENSIONAL_QUANTITY")   // false
        isDimensionalQuantity(0, "MUST_CONSIDER_DIMENSIONLESS_ZERO_AS_DIMENSIONAL_QUANTITY")   // true
        isDimensionalQuantity(0, "MUST_NOT_CONSIDER_DIMENSIONLESS_ZERO_AS_DIMENSIONAL_QUANTITY") // false

    +AdmonitionBlock--YDF({
      title: "The Second Parameter is Required",
      SVG_Icon: true,
      geometricVariation: AdmonitionBlock__YDF.GeometricVariations.stickyNoteLike,
      decorativeVariation: AdmonitionBlock__YDF.DecorativeVariations.warning
    }).
      The #[+Keyword--YDID second] #[+Term--YDID parameter] #[+Keyword--YDID must] be specified #[+Keyword--YDID always]
        #[+Keyphrase--YDID regardless of value of the #[+Keyword--YDID first] one].

    p.Article-Paragraph.
      In the above example the values of #[+Keyword--YDID first] #[+Term--YDID parameter] are hardcoded ones, but in
        practice commonly the value will #[+Keyword--YDID dynamic] (it means
        #[+Keyword--YDID unknown] #[+Keyphrase--YDID at advance]), that is why the #[+Keyword--YDID second] is
        #[+Keyword--YDID always] #[+Keyword__Contrast--YDID required].


    //- ╍╍╍ `isDimensionlessQuantity` ╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍
    +Heading--YDF({
      level: 3,
      innerHTML: localizedSectioning.quantities.$children.isDimensionlessQuantity.$heading,
      HTML_ID: localizedSectioning.quantities.$children.isDimensionlessQuantity.$anchor
    }).Article-Heading3

    p.Article-Paragraph.
      Returns #[+ImportantEntity__Code--YDID true] if the #[+Term--YDID parameter's] #[+Term__Contrast--YDID value] is a
        #[+Keyword--YDID dimensionless] #[+Term--YDID quantity], otherwise returns #[+ImportantEntity__Code--YDID false],
        herewith the #[+ImportantEntity--YDID 0] will #[+Keyword--YDID always] be considered as a
        #[+Keyword--YDID dimensionless] #[+Term--YDID quantity].

    +CodeViewer--YDF
      +CodeViewer-Listing--YDF({ codeLanguage: CodeViewer__YDF.SupportedCodesLanguages.Stylus }): :code_listing--yda
        isDimensionlessQuantity(2px) // false
        isDimensionlessQuantity(2)   // true
        isDimensionlessQuantity(0)   // true


    //- ╍╍╍ `isNaturalNumber` ╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍
    +Heading--YDF({
      level: 3,
      innerHTML: localizedSectioning.quantities.$children.isNaturalNumber.$heading,
      HTML_ID: localizedSectioning.quantities.$children.isNaturalNumber.$anchor
    }).Article-Heading3

    p.Article-Paragraph.
      Returns #[+ImportantEntity__Code--YDID true] #[+Keyphrase--YDID if and only if] #[+Term--YDID parameter's] value
        is a #[+Keyword--YDID dimensionless] #[+Term--YDID quantity] representing the #[+Keyword--YDID natural]
        #[+Term--YDID number].

    +AdmonitionBlock--YDF({
      SVG_Icon: true,
      geometricVariation: AdmonitionBlock__YDF.GeometricVariations.stickyNoteLike,
      decorativeVariation: AdmonitionBlock__YDF.DecorativeVariations.warning
    }) Recall that #[+ImportantEntity--YDID 0] is&nbsp;#[+Keyword--YDID not]&nbsp;a&nbsp;#[+Term--YDID natural number].

    +CodeViewer--YDF
      +CodeViewer-Listing--YDF({ codeLanguage: CodeViewer__YDF.SupportedCodesLanguages.Stylus }): :code_listing--yda
        p(isNaturalNumber(1))    // true
        p(isNaturalNumber(0))    // false
        p(isNaturalNumber(1.1))  // false
        p(isNaturalNumber(1e+1)) // false
        p(isNaturalNumber(-1))   // false


    //- ┅┅┅ Булевские значения ┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅┅
    +Heading--YDF({
      level: 2,
      text: localizedSectioning.booleans.$heading,
      HTML_ID: localizedSectioning.booleans.$anchor
    }).Article-Heading2

    p.Article-Paragraph.
      Being the language #[+Keyword--YDID without] built-in #[+Term--YDID type safety],　#[+ImportantEntity--YDID Stylus]
        has the #[+Keyword--YDID automatic] #[+Term--YDID coercion] of　#[+Keyword--YDID non-boolean] values to
        #[+Term--YDID booleans] (for example in　#[+Term--YDID conditional expressions]).
      However sometimes #[+ImportantEntity--YDID Stylus] behaviour is different with
        #[+ImportantEntity--YDID JavaScript]-like to which web programmers are accustomed.
      For example, the #[+SecondaryEntity__Code--YDID if someVariable] check will be #[+Keyword--YDID truthy]
        (#[+Keyphrase--YDID in #[+ImportantEntity--YDID Stylus] language]) even if
        #[+SecondaryEntity__Code--YDID someVariable] has #[+Keyword--YDID not]&nbsp;been initialized.

    +CodeViewer--YDF
      +CodeViewer-Listing--YDF({ codeLanguage: CodeViewer__YDF.SupportedCodesLanguages.Stylus }): :code_listing--yda
        definedVariable = true

        if definedVariable

          p("Obviously, it will be printed to console.")


        if undefinedVariable

          p("It will be printed too because 'typeof(undefinedVariable)' is 'ident' what will not be coerced to false.")


    p.Article-Paragraph.
      To avoid the unexpected bugs, the #[+Keyword--YDID explicit] checking like
        #[+ImportantEntity__Code--YDID someVariable == true] or #[+ImportantEntity__Code--YDID someVariable == false]
        checking is recommended, but #[+ImportantEntity__Code--YDID isTrue(someVariable)] and
        #[+ImportantEntity__Code--YDID isFalse(someVariable)] suggesting by this library are the
        #[+Keyword--YDID alternatives].


    //- ╍╍╍ `isBoolean` ╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍
    +Heading--YDF({
      level: 3,
      innerHTML: localizedSectioning.booleans.$children.isBoolean.$heading,
      HTML_ID: localizedSectioning.booleans.$children.isBoolean.$anchor
    }).Article-Heading3

    p.Article-Paragraph.
      The short #[+Keyword--YDID alternative] of a #[+Term--YDID comparing expression]
        #[+ImportantEntity__Code--YDID typeof(x) == "boolean"], where #[+SecondaryEntity__Code--YDID x] is an
        #[+Keyword--YDID arbitrary] #[+Term--YDID variable] even it has not&nbsp;been initialized.


    //- ╍╍╍ `isFalse` ╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍
    +Heading--YDF({
     level: 3,
     innerHTML: localizedSectioning.booleans.$children.isFalse.$heading,
     HTML_ID: localizedSectioning.booleans.$children.isFalse.$anchor
    }).Article-Heading3

    p.Article-Paragraph.
      The #[+Keyword--YDID alternative] of a #[+Term--YDID comparing expression] #[+ImportantEntity__Code--YDID x == false],
        where #[+SecondaryEntity__Code--YDID x] is and #[+Keyword--YDID arbitrary] #[+Term--YDID variable] even it has
        not&nbsp;been initialized.


    //- ╍╍╍ `isTrue` ╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍╍
    +Heading--YDF({
      level: 3,
      innerHTML: localizedSectioning.booleans.$children.isTrue.$heading,
      HTML_ID: localizedSectioning.booleans.$children.isTrue.$anchor
    }).Article-Heading3

    p.Article-Paragraph.
