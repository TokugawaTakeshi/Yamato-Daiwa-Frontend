        p(sample1)
        p(typeof(sample1))
        p(sample1 == null)
        p(typeof(sample1) == "null")

    p.Article-Paragraph.
      #[+Keyphrase--YDID For now], the #[+ImportantEntity--YDID Stylus] works as expected:

    +ConsoleOutput--YDF: :html_special_characters_to_html_entities
