block append Metadata

  -

    const {
      $heading: pageTopHeading,
      $sectioning: localizedSectioning
    } = localizedRouting.coreLibrary.$children.styles.$children.kernel.$children.functions.$children.typeCheckers;

    RegularWebPageTemplate__YDF.configure({
      metadata: {
        title: buildHTML_PageTitle(pageTopHeading),
        description:
          "The library \"Yamato Daiwa Frontend\" (abbreviation: \"YDF\") for the frontend development suggests the " +
            "Stylus-functions for the checking of values' types allowing to get more information about value than the " +
            "standard \"typeof\" function."
      },
      stylesSheetsURIs: [
        "$CommonStyles",
        "$LayoutsStyles/TwoColumns/TwoColumnsLayout.css",
        "$PreMadesStyles",
        "@CustomizedExternalComponents"
      ]
    });

    YDF.RoutingEmulator.setCurrentRoute("coreLibrary.styles.kernel.functions.typeCheckers");

    LanguageDropDownList__YDF_DK.setLinks({
      japanese: routing.japanese.coreLibrary.$children.styles.$children.kernel.$children.functions.$children.
          typeCheckers.$URI,
      russian: routing.russian.coreLibrary.$children.styles.$children.kernel.$children.functions.$children.
          typeCheckers.$URI
    });


