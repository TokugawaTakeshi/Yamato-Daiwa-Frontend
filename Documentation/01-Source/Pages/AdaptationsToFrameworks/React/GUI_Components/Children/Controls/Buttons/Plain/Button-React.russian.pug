      metadata: {
        title: buildHTML_PageTitle(topHeading),
        description: MetaDescriptionTemplates.GUI_Components.controls.buttons.Button
      },
      stylesSheetsURIs: [
        "$CommonStyles",
        "$LayoutsStyles/TwoColumns/TwoColumnsLayout.css",
        "$PreMadesStyles",
        "@CustomizedExternalComponents"
      ]
    });

    YDF.RoutingEmulator.setCurrentRoute("adaptationsToFrameworks.react.GUI_Components.controls.buttons.plain");

    LanguageDropDownList__YDF_DK.setLinks({
      english: routing.english.adaptationsToFrameworks.$children.react.$children.GUI_Components.$children.
          controls.$children.buttons.$children.plain.$URI,
      japanese: routing.japanese.adaptationsToFrameworks.$children.react.$children.GUI_Components.$children.
          controls.$children.buttons.$children.plain.$URI
    });


