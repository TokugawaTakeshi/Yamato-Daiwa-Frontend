block append Requirements

  include ../../../../../../SharedAssets/Markup/SharedAssets.japanese.pug
  include ../../../../../../SharedComponents/SharedComponents.japanese.pug


block append Metadata

  -

    const {
      $heading: topHeading,
      $sectioning: localizedSectioning
    } = localizedRouting.adaptationsToFrameworks.$children.blazor.$children.GUI_Components.$children.Badge;

    RegularWebPageTemplate__YDF.configure({
      metadata: {
        title: buildHTML_PageTitle(topHeading),
        description: MetaDescriptionTemplates.GUI_Components.Badge
      },
      stylesSheetsURIs: [
        "$CommonStyles",
        "$LayoutsStyles/TwoColumns/TwoColumnsLayout.css",
        "$PreMadesStyles",
        "@CustomizedExternalComponents"
      ]
    });

    YDF.RoutingEmulator.setCurrentRoute("adaptationsToFrameworks.blazor.GUI_Components.Badge");

    LanguageDropDownList__YDF_DK.setLinks({
      english: routing.english.adaptationsToFrameworks.$children.blazor.$children.GUI_Components.$children.Badge.$URI,
      russian: routing.russian.adaptationsToFrameworks.$children.blazor.$children.GUI_Components.$children.Badge.$URI
    });


block append HeadScripts

  if __IS_PRODUCTION_BUILDING_MODE__

    +GoogleAnalyticsScript


