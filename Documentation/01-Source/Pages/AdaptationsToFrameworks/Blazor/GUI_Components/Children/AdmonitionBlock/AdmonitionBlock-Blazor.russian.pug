    RegularWebPageTemplate__YDF.configure({
      metadata: {
        title: buildHTML_PageTitle(topHeading),
        description: MetaDescriptionTemplates.GUI_Components.AdmonitionBlock
      },
      stylesSheetsURIs: [
        "$CommonStyles",
        "$LayoutsStyles/TwoColumns/TwoColumnsLayout.css",
        "$PreMadesStyles",
        "@CustomizedExternalComponents"
      ]
    });

    YDF.RoutingEmulator.setCurrentRoute("adaptationsToFrameworks.blazor.GUI_Components.AdmonitionBlock");

    LanguageDropDownList__YDF_DK.setLinks({
      english: routing.english.adaptationsToFrameworks.$children.blazor.$children.GUI_Components.$children.AdmonitionBlock.$URI,
      japanese: routing.japanese.adaptationsToFrameworks.$children.blazor.$children.GUI_Components.$children.AdmonitionBlock.$URI
    });


