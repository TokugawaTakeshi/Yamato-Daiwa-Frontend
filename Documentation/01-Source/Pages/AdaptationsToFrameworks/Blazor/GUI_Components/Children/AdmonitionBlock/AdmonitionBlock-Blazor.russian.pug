      +Heading--YDF({
        level: 2,
        innerHTML: localizedSectioning.AdmonitionBlockClass.$heading,
        HTML_ID: localizedSectioning.AdmonitionBlockClass.$anchor
      }).Article-Heading2

      //- ─── Blazor-свойства ───────────────────────────────────────────────────────────────────────────────────────────────
