extends {{ projectRootDirectoryPathRelativeToDirectoryForNativeImplementation }}/node_modules/@yamato-daiwa/programming_documentation/Layouts/TwoColumns/TwoColumnsLayout.pug


block append Requirements

  include {{ sourceDirectoryPathRelativeToDirectoryForNativeImplementation }}/SharedAssets/Markup/SharedAssets.japanese.pug
  include {{ sourceDirectoryPathRelativeToDirectoryForNativeImplementation }}/SharedComponents/SharedComponents.japanese.pug


block append Metadata

  -

    const {
      $heading: topHeading,
      $sectioning: localizedSectioning
    } = localizedRouting.{{ targetRouteForCoreLibraryWithChildrenPointers }};

    RegularWebPageTemplate__YDF.configure({
      metadata: {
        title: buildHTML_PageTitle(topHeading),
        //- TODO ↓ ①　完全名が正しくなければ、編集して下さい
        description: MetaDescriptionTemplates.GUI_Components.{{ GUI_ComponentName__pascalCase }}
      },
      stylesSheetsURIs: [
        "$CommonStyles",
        "$LayoutsStyles/TwoColumns/TwoColumnsLayout.css",
        "$PreMadesStyles",
        "@CustomizedExternalComponents"
      ]
    });

    YDF.RoutingEmulator.setCurrentRoute("{{ targetRouteForCoreLibraryWithoutChildrenPointers }}");

    LanguageDropDownList__YDF_DK.setLinks({
      english: routing.english.{{ targetRouteForCoreLibraryWithChildrenPointers }}.$URI,
      russian: routing.russian.{{ targetRouteForCoreLibraryWithChildrenPointers }}.$URI
    });


block append HeadScripts

  if __IS_PRODUCTION_BUILDING_MODE__

    +GoogleAnalyticsScript


