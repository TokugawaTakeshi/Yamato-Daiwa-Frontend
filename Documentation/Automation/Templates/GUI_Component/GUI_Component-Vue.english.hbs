block append Requirements

  include {{ sourceDirectoryPathRelativeToDirectoryForAdaptationsToFrameworks }}/SharedAssets/Markup/SharedAssets.english.pug
  include {{ sourceDirectoryPathRelativeToDirectoryForAdaptationsToFrameworks }}/SharedComponents/SharedComponents.english.pug


block append Metadata

  -

    const {
      $heading: topHeading,
      $sectioning: localizedSectioning
    } = localizedRouting.{{ targetRouteForVueFrameworkWithChildrenPointers }};

    RegularWebPageTemplate__YDF.configure({
      metadata: {
        title: buildHTML_PageTitle(topHeading),
        //- TODO ↓ ①　Edit the fully qualified name if it is incorrect
        description: MetaDescriptionTemplates.GUI_Components.{{ GUI_ComponentName__pascalCase }}
      },
      stylesSheetsURIs: [
        "$CommonStyles",
        "$LayoutsStyles/TwoColumns/TwoColumnsLayout.css",
        "$PreMadesStyles",
        "@CustomizedExternalComponents"
      ]
    });

    YDF.RoutingEmulator.setCurrentRoute("{{ targetRouteForVueFrameworkWithoutChildrenPointers }}");

    LanguageDropDownList__YDF_DK.setLinks({
      japanese: routing.japanese.{{ targetRouteForVueFrameworkWithChildrenPointers }}.$URI,
      russian: routing.russian.{{ targetRouteForVueFrameworkWithChildrenPointers }}.$URI
    });


block append HeadScripts

