extends {{ projectRootDirectoryPathRelativeToDirectoryForAdaptationsToFrameworks }}/node_modules/@yamato-daiwa/programming_documentation/Layouts/TwoColumns/TwoColumnsLayout.pug


block append Requirements

  include {{ sourceDirectoryPathRelativeToDirectoryForAdaptationsToFrameworks }}/SharedAssets/Markup/SharedAssets.russian.pug
  include {{ sourceDirectoryPathRelativeToDirectoryForAdaptationsToFrameworks }}/SharedComponents/SharedComponents.russian.pug


block append Metadata

  -

    const {
      $heading: topHeading,
      $sectioning: localizedSectioning
    } = localizedRouting.{{ targetRouteForVueFrameworkWithChildrenPointers }};

    RegularWebPageTemplate__YDF.configure({
      metadata: {
        title: buildHTML_PageTitle(topHeading),
        //- TODO ↓ ①　Редактировать полное квалификационное имя если оно не верно
        description: MetaDescriptionTemplates.GUI_Components.{{ GUI_ComponentName__pascalCase }}
      },
      stylesSheetsURIs: [
        "$CommonStyles",
        "$LayoutsStyles/TwoColumns/TwoColumnsLayout.css",
        "$PreMadesStyles",
        "@CustomizedExternalComponents"
      ]
    });

    RoutingEmulator.setCurrentRoute("{{ targetRouteForVueFrameworkWithoutChildrenPointers }}");

    LanguageDropDownList__YDF_DK.setLinks({
      english: routing.english.{{ targetRouteForVueFrameworkWithChildrenPointers }}.$URI,
      japanese: routing.japanese.{{ targetRouteForVueFrameworkWithChildrenPointers }}.$URI
    });


block append HeadScripts

  if __IS_PRODUCTION_BUILDING_MODE__

    +GoogleAnalyticsScript


